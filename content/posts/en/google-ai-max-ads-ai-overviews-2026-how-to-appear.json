    "translation_of": "google-ai-max-ads-ai-overviews-2026-como-aparecer",
    "key_entities": "Google Ads, AI Max for Search campaigns, AI Overviews, AI Mode, Performance Max, Shopping, broad match, text customization, final URL expansion, brand exclusions, Google Marketing Live",
    "faq_items": [
      {
        "_type": "block",
        "style": "h3",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "Is AI Max the same as ads in AI Overviews?",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "No. AI Max for Search is a set of features you turn on inside a Search campaign to broaden matching and generate ad text. Ads in AI Overviews are a placement inside Google's AI summaries. Turning on AI Max is one way for a Search campaign to become eligible for that placement, but not the only one.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "h3",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "Can I pay to appear only in AI Overviews?",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "No. According to Google Ads Help, you can't target ads exclusively to AI Overviews or AI Mode, or opt out of them separately from Search. You can control where ads show with negative keywords and brand exclusions.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "h3",
        "markDefs": [],
        "children": [
