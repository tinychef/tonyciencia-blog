      }
    ],
    "key_entities": "Anthropic, SpaceX, xAI, Colossus 1, Claude, Claude Code, Claude Opus, NVIDIA, Amazon, Google, Broadcom, Microsoft, Fluidstack, Bloomberg Law",
    "faq_items": [
      {
        "_type": "block",
        "style": "h3",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "Did Anthropic merge with SpaceX?",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "No. On May 6, 2026, Anthropic announced an agreement to use all of the compute capacity at SpaceX's Colossus 1 data center. It is not a merger or an acquisition, and the announcement does not mention Claude being used on Starship missions.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "h3",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "What changed in Claude Code's limits?",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "Anthropic doubled Claude Code's five-hour rate limits on Pro, Max, Team and seat-based Enterprise plans, removed the peak-hours limit reduction for Pro and Max accounts and raised API rate limits considerably for Claude Opus models.",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "h3",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "How much is Anthropic paying SpaceX for Colossus 1?",
            "marks": []
          }
        ]
      },
      {
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_type": "span",
            "text": "According to Bloomberg Law, citing SpaceX's IPO paperwork, Anthropic is expected to pay $1.25 billion per month through May 2029, nearly $45 billion in total, and either party can end the agreement with 90 days' notice.",
            "marks": []
          }
        ]
      }
    ],
