---
import { getSiteSettings } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { getLangFromUrl, getAlternateLocale, getLocalePath, useTranslations } from "../i18n/locales";
import SchemaOrg from "../components/SchemaOrg.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	breadcrumbs?: Array<{ name: string; url: string }> | null;
	schemaType?: string | null;
	faqItems?: Array<{ question: string; answer: string }> | null;
	readingTime?: number | null;
	alternatePath?: string | null;
	/** Página sin traducción: el botón de idioma lleva aquí, pero no se declara
	 *  hreflang (no es una versión equivalente). */
	languageFallback?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	breadcrumbs,
	schemaType,
	faqItems,
	readingTime,
	alternatePath,
	languageFallback,
	content,
} = Astro.props;
const { siteTitle, siteFavicon } = resolveBlogSiteIdentity(await getSiteSettings());
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;

// i18n
const locale = getLangFromUrl(Astro.url);
const altLocale = getAlternateLocale(locale);
const t = useTranslations(locale);
const hasTranslation = !languageFallback;
const altPath = languageFallback || alternatePath || getLocalePath(Astro.url.pathname, altLocale);
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;
const altUrl = new URL(altPath, Astro.site || Astro.url.origin).href;
const xDefaultUrl = locale === "en" && hasTranslation ? altUrl : canonicalUrl;

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;

// Navegación principal (escritorio y menú móvil comparten la lista).
const navItems = [
	{ href: locale === "en" ? "/en/posts" : "/posts", label: t("nav.blog") },
	{ href: locale === "en" ? "/en/services" : "/servicios", label: t("nav.services") },
	...(locale === "es" ? [{ href: "/herramientas", label: "Herramientas" }] : []),
	{ href: "/market", label: "Market", market: true },
	{ href: locale === "en" ? "/en/about" : "/about", label: t("nav.aboutMe") },
	{ href: locale === "en" ? "/en/contact" : "/contacto", label: t("nav.contact") },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const homeHref = locale === "en" ? "/en" : "/";
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Solo se precarga Inter normal: la cursiva no se usa arriba del pliegue y competía con el LCP. -->
		<Font cssVariable="--font-sans" preload={[{ style: "normal" }]} />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<meta name="author" content="Antonio Duque — Tony Ciencia" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang={locale} href={canonicalUrl} />
		{hasTranslation && <link rel="alternate" hreflang={altLocale} href={altUrl} />}
		<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
		<link rel="alternate" type="application/rss+xml" title={siteTitle} href={`${Astro.url.origin}/rss.xml`} />
		{locale === "en" && <link rel="alternate" type="application/rss+xml" title={`${siteTitle} (EN)`} href={`${Astro.url.origin}/en/rss.xml`} />}
		<meta property="og:type" content={type} />
		<meta property="og:title" content={pageTitle ?? title} />
		<meta property="og:description" content={description ?? ""} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={locale === "en" ? "en_US" : "es_ES"} />
		<meta property="og:locale:alternate" content={locale === "en" ? "es_ES" : "en_US"} />
		<meta property="og:image" content={image ?? `${Astro.site ?? Astro.url.origin}/assets/og-default.webp`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${title} — Tony Ciencia`} />
		<meta property="og:site_name" content="Tony Ciencia" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@tonyciencia" />
		<meta name="twitter:title" content={pageTitle ?? title} />
		<meta name="twitter:description" content={description ?? ""} />
		<meta name="twitter:image" content={image ?? `${Astro.site ?? Astro.url.origin}/assets/og-default.webp`} />
		<link rel="icon" href={siteFavicon || "/favicon.ico"} sizes="any" />
		<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<SchemaOrg type={type} title={fullTitle} description={description} url={canonicalUrl} image={image} locale={locale} publishedTime={publishedTime} modifiedTime={modifiedTime} author={author} breadcrumbs={breadcrumbs} schemaType={schemaType} faqItems={faqItems} readingTime={readingTime} />
		<EmDashHead page={pageCtx} />
		<Analytics />
		<!-- Miniatura del último video (home). -->
		<link rel="dns-prefetch" href="https://i.ytimg.com" />
		<script is:inline type="speculationrules" set:html={JSON.stringify({
			prerender: [{
				where: { href_matches: "/posts/*" },
				eagerness: "moderate"
			}, {
				where: { href_matches: "/en/posts/*" },
				eagerness: "moderate"
			}]
		})} />
		<script is:inline>
			// Apply theme immediately to prevent flash — oscuro por defecto;
			// claro solo si el visitante lo eligió con el toggle (cookie "scheme").
			// La cookie vieja "theme" se ignora: la versión anterior la escribía en
			// cada visita aunque nadie eligiera nada.
			(function () {
				var m = document.cookie.match(/(?:^|; )scheme=([^;]+)/);
				document.documentElement.classList.add(m && m[1] === "light" ? "light" : "dark");
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main-content" class="skip-to-content">{t("nav.skip")}</a>
		<header class="site-header" data-site-header>
			<span class="scroll-progress" aria-hidden="true"></span>
			<nav class="nav" aria-label={locale === "en" ? "Main" : "Principal"}>
				<a href={homeHref} class="site-title" style="display: flex; align-items: center;" aria-label={siteTitle}>
					<img src="/assets/logo-tc-negro-72.webp" alt={siteTitle} class="site-logo-img logo-light" width="36" height="36" />
					<img src="/assets/logo-tc-blanco-72.webp" alt={siteTitle} class="site-logo-img logo-dark" aria-hidden="true" width="36" height="36" />
				</a>
				<div class="nav-right">
					<LanguageSwitcher alternatePath={altPath} />
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								{t("nav.admin")}
							</a>
						)
					}
					<a href="/market" class="nav-cta" aria-current={currentPath.startsWith("/market") ? "page" : undefined} hreflang={locale === "en" ? "es" : undefined}>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
						<span>Market</span>
					</a>
					<button type="button" class="nav-burger" aria-label={t("nav.menu") || "Menu"} aria-expanded="false" aria-controls="mobile-menu">
						<span class="burger-icon" aria-hidden="true">
							<span class="burger-line"></span>
							<span class="burger-line"></span>
							<span class="burger-line"></span>
						</span>
						<span class="burger-label">{t("nav.menu")}</span>
					</button>
				</div>
			</nav>
		</header>

		<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label={t("nav.menu")} hidden>
			<div class="mobile-menu-inner">
				<div class="mobile-menu-top">
					<span class="mobile-menu-kicker">{t("nav.menu")}</span>
					<button type="button" class="mobile-menu-close" data-menu-close aria-label={locale === "en" ? "Close menu" : "Cerrar menú"}>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
						<span>{locale === "en" ? "Close" : "Cerrar"}</span>
					</button>
				</div>
				{navItems.map((item) => (
					<a
						href={item.href}
						class:list={["mobile-menu-link", { "is-market": item.market }]}
						aria-current={isActive(item.href) ? "page" : undefined}
						hreflang={item.market && locale === "en" ? "es" : undefined}
					>
						<span>{item.label}</span>
						{item.market ? <span class="mobile-menu-badge">{locale === "en" ? "Shop" : "Tienda"}</span> : <span class="mobile-menu-arrow" aria-hidden="true">→</span>}
					</a>
				))}
				<a href="/market/agentes-para-empresas" class="mobile-menu-cta" hreflang={locale === "en" ? "es" : undefined} data-market-v2={locale === "en" ? "/en/contact" : "/contacto"}>
					{locale === "en" ? "Custom AI agents for companies" : "Agentes de IA para empresas"}
				</a>
				<div class="mobile-menu-divider"></div>
				<div class="mobile-menu-row">
					<LanguageSwitcher alternatePath={altPath} />
					<div class="theme-switcher">
						<button type="button" class="theme-toggle" aria-label={locale === "en" ? "Toggle theme" : "Cambiar tema"} aria-pressed="false">
							<svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
							<svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
						</button>
					</div>
					<div class="mobile-menu-social">
					<a href="https://youtube.com/@tonyciencia" target="_blank" rel="noopener noreferrer" class="mobile-social-link" aria-label="YouTube">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
					</a>
					<a href="https://instagram.com/tonyciencia" target="_blank" rel="noopener noreferrer" class="mobile-social-link" aria-label="Instagram">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
					</a>
					<a href="https://x.com/tonyciencia" target="_blank" rel="noopener noreferrer" class="mobile-social-link" aria-label="X / Twitter">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
					</a>
				</div>
				</div>
			</div>
		</div>

		{breadcrumbs && breadcrumbs.length > 0 && (
			<Breadcrumbs items={breadcrumbs} locale={locale} />
		)}
		<main id="main-content">
			<slot />
		</main>

		<Footer locale={locale} siteTitle={siteTitle} alternatePath={altPath} />
		<CookieConsent />

		<script>
			// Theme switcher
			const THEME_REGEX = /(?:^|; )scheme=([^;]+)/;
			const themeToggle = document.querySelector(".theme-toggle");
			const root = document.documentElement;

			function setCookie(name: string, value: string, maxAge = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				if (value === "") {
					document.cookie = `${name}=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
				}
			}

			function getStoredTheme(): "light" | "dark" {
				const match = document.cookie.match(THEME_REGEX);
				if (match?.[1] === "dark" || match?.[1] === "light") return match[1];
				return "dark";
			}

			function setTheme(theme: "light" | "dark", persist = true) {
				if (persist) setCookie("scheme", theme);
				root.classList.remove("light", "dark");
				root.classList.add(theme);
				themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
			}

			// Initialize
			// Sin elección explícita no se escribe cookie: así el default oscuro
			// sigue aplicando y no queda "pegado" un tema que nadie eligió.
			setTheme(getStoredTheme(), Boolean(document.cookie.match(THEME_REGEX)));

			if (themeToggle) {
				themeToggle.addEventListener("click", (e) => {
					const isDark = root.classList.contains("dark");
					const nextTheme = isDark ? "light" : "dark";

					// Ripple origin: center of the toggle button
					const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
					root.style.setProperty("--ripple-x", `${rect.left + rect.width / 2}px`);
					root.style.setProperty("--ripple-y", `${rect.top + rect.height / 2}px`);

					if (!document.startViewTransition) {
						setTheme(nextTheme);
						return;
					}

					root.dataset.themeTransition = "1";
					const t = document.startViewTransition(() => setTheme(nextTheme));
					t.finished.finally(() => delete root.dataset.themeTransition);
				});
			}

		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			/* ── Theme ripple transition (bombilla expansiva) ── */
			:root[data-theme-transition]::view-transition-new(root) {
				animation: theme-ripple 0.65s cubic-bezier(0.4, 0, 0.2, 1) both;
				clip-path: circle(0 at var(--ripple-x, 50%) var(--ripple-y, 50%));
				z-index: 99999;
			}
			:root[data-theme-transition]::view-transition-old(root) {
				animation: none;
				z-index: -1;
			}
			@keyframes theme-ripple {
				to { clip-path: circle(160vmax at var(--ripple-x, 50%) var(--ripple-y, 50%)); }
			}
			@media (prefers-reduced-motion: reduce) {
				:root[data-theme-transition]::view-transition-new(root),
				:root[data-theme-transition]::view-transition-old(root) {
					animation: none;
				}
			}

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				:root {
					/* Colors - Light mode (default) */
					--color-bg: #ffffff;
					--color-bg-subtle: #fafafa;
					--color-text: #1a1a1a;
					--color-text-secondary: #525252;
					--color-muted: #8b8b8b;
					--color-border: #e5e5e5;
					--color-border-subtle: #f0f0f0;
					--color-surface: #f7f7f7;
					--color-accent: #0066cc;
					--color-accent-hover: #0052a3;
					--color-on-accent: white;
					--color-accent-ring: color-mix(
						in srgb,
						var(--color-accent) 25%,
						transparent
					);

					/* EmDash search theming */
					--emdash-search-bg: var(--color-bg);
					--emdash-search-text: var(--color-text);
					--emdash-search-muted: var(--color-muted);
					--emdash-search-border: var(--color-border);
					--emdash-search-hover: var(--color-surface);
					--emdash-search-highlight: var(--color-text);

					/* Type scale — xs through 3xl live in theme.css (unlayered, always wins
					   over this reset); only the sizes theme.css doesn't touch stay here. */
					--font-size-4xl: 2.5rem;
					--font-size-5xl: 3.5rem;

					/* Line heights — leading-tight is set in theme.css (unlayered, wins over
					   this reset); only what it doesn't touch stays here. */
					--leading-snug: 1.3;
					--leading-normal: 1.5;
					--leading-relaxed: 1.7;

					/* Spacing - more generous */
					--spacing-1: 0.25rem;
					--spacing-2: 0.5rem;
					--spacing-3: 0.75rem;
					--spacing-4: 1rem;
					--spacing-5: 1.25rem;
					--spacing-6: 1.5rem;
					--spacing-8: 2rem;
					--spacing-10: 2.5rem;
					--spacing-12: 3rem;
					--spacing-16: 4rem;
					--spacing-20: 5rem;
					--spacing-24: 6rem;

					/* Legacy spacing aliases */
					--spacing-xs: var(--spacing-1);
					--spacing-sm: var(--spacing-2);
					--spacing-md: var(--spacing-4);
					--spacing-lg: var(--spacing-6);
					--spacing-xl: var(--spacing-8);
					--spacing-2xl: var(--spacing-12);
					--spacing-3xl: var(--spacing-16);

					/* Layout - wider for three-column */
					--content-width: 680px;
					--wide-width: 1200px;
					--max-width: var(--content-width);
					--gutter-width: 200px;
					--radius: 4px;
					--radius-lg: 8px;

					/* Transitions */
					--transition-fast: 120ms ease;
					--transition-base: 180ms ease;

					/* Nav */
					--nav-height: 64px;

					/* Search */
					--search-input-width: 180px;

					/* Article layout */
					--meta-col-width: 180px;

					/* Avatar sizes */
					--avatar-size-xs: 18px;
					--avatar-size-sm: 20px;
					--avatar-size-md: 24px;
					--avatar-size-lg: 32px;

					/* Letter spacing — tracking-tight lives in theme.css (unlayered, wins
					   over this reset); only what it doesn't touch stays here. */
					--tracking-snug: -0.02em;
					--tracking-wide: 0.06em;
					--tracking-wider: 0.08em;

					/* Tag pill */
