						".site-search-input"
					) as HTMLInputElement;
					if (searchInput) {
						searchInput.focus();
					}
				}
			});

			// Menú (panel completo en celular, lateral en escritorio): se cierra con la X de la cabecera,
			// el botón "Cerrar", Escape, tocando el fondo o un enlace. Mientras está abierto, el foco no sale del menú.
			(function () {
				const burger = document.querySelector<HTMLButtonElement>(".nav-burger");
				const mobileMenu = document.getElementById("mobile-menu");
				if (!burger || !mobileMenu) return;
				let closeTimer: number | undefined;

				function focusables() {
					return [burger!, ...mobileMenu!.querySelectorAll<HTMLElement>("a[href], button")].filter((el) => el.offsetParent !== null);
				}

				function openMenu() {
					clearTimeout(closeTimer);
					mobileMenu!.hidden = false;
					requestAnimationFrame(() => mobileMenu!.classList.add("is-open"));
					burger!.classList.add("is-open");
					burger!.setAttribute("aria-expanded", "true");
					document.body.classList.add("menu-open");
					document.body.style.overflow = "hidden";
					mobileMenu!.querySelector<HTMLElement>(".mobile-menu-link")?.focus({ preventScroll: true });
				}

				function closeMenu(returnFocus = true) {
					burger!.classList.remove("is-open");
					burger!.setAttribute("aria-expanded", "false");
					mobileMenu!.classList.remove("is-open");
					document.body.classList.remove("menu-open");
					document.body.style.overflow = "";
					closeTimer = window.setTimeout(() => (mobileMenu!.hidden = true), 250);
					if (returnFocus) burger!.focus({ preventScroll: true });
				}

				const isOpen = () => burger.classList.contains("is-open");
				burger.addEventListener("click", () => (isOpen() ? closeMenu() : openMenu()));
				mobileMenu.querySelector("[data-menu-close]")?.addEventListener("click", () => closeMenu());

				// Tocar el fondo (fuera de los enlaces) también cierra.
				mobileMenu.addEventListener("click", (e) => {
					const target = e.target as HTMLElement;
					if (target === mobileMenu || target.classList.contains("mobile-menu-inner")) closeMenu();
				});

				document.addEventListener("keydown", (e) => {
					if (!isOpen()) return;
					if (e.key === "Escape") {
						closeMenu();
						return;
					}
					if (e.key === "Tab") {
						const items = focusables();
						const first = items[0];
						const last = items[items.length - 1];
						if (e.shiftKey && document.activeElement === first) {
							e.preventDefault();
							last?.focus();
						} else if (!e.shiftKey && document.activeElement === last) {
							e.preventDefault();
							first?.focus();
						}
					}
				});

				mobileMenu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => closeMenu(false)));

				// Al volver con "atrás" (bfcache) el menú nunca queda abierto.
				window.addEventListener("pageshow", () => isOpen() && closeMenu(false));
			})();

			// Respaldo temporal: los enlaces a páginas del Market v2 (data-market-v2) van a su alternativa
			// mientras el market desplegado no las tenga (se detecta por /market/sitemap.xml, que solo existe en v2).
			// En cuanto el market v2 está en producción, no se cambia nada. Se puede borrar después.
			// Una sola consulta por sesión (sessionStorage), no una por página.
			(function () {
				const links = document.querySelectorAll<HTMLAnchorElement>("a[data-market-v2]");
				if (!links.length) return;
				const KEY = "tc_market_v2";
				const applyFallback = () =>
					links.forEach((a) => {
						const fallback = a.dataset.marketV2 ?? "";
						if (fallback === "hide") a.closest("li")?.remove();
						else a.href = fallback;
					});
				let known: string | null = null;
				try {
					known = sessionStorage.getItem(KEY);
				} catch {
					/* almacenamiento bloqueado */
				}
				if (known === "1") return;
				if (known === "0") return applyFallback();
				fetch("/market/sitemap.xml", { method: "HEAD" })
					.then((res) => {
						try {
							sessionStorage.setItem(KEY, res.ok ? "1" : "0");
						} catch {
							/* almacenamiento bloqueado */
						}
						if (!res.ok) applyFallback();
					})
					.catch(() => {});
			})();

			// Cabecera con sombra al bajar + barra de progreso de lectura.
			(function () {
				const header = document.querySelector<HTMLElement>("[data-site-header]");
				if (!header) return;
				let queued = false;
				const update = () => {
					queued = false;
					const y = window.scrollY;
					header.classList.toggle("is-scrolled", y > 8);
					const max = document.documentElement.scrollHeight - window.innerHeight;
					header.style.setProperty("--progress", max > 0 ? String(Math.min(1, y / max)) : "0");
				};
				window.addEventListener("scroll", () => {
					if (!queued) {
						queued = true;
						requestAnimationFrame(update);
					}
				}, { passive: true });
				update();
			})();

			// Efectos globales: aparición al hacer scroll ([data-reveal]) y luz que sigue al cursor
			// en tarjetas y filas (.tc-card, .line-item, .svc). Respetan "reducir movimiento".
			(function () {
				const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
				if (!reduced && "IntersectionObserver" in window) {
					targets.forEach((target) => target.classList.add("reveal"));
					const observer = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							});
						},
						{ threshold: 0.12 },
					);
					targets.forEach((target) => observer.observe(target));
				}
				if (reduced || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
				document.addEventListener("pointermove", (e) => {
					const el = (e.target as HTMLElement | null)?.closest<HTMLElement>(".tc-card, .line-item, .svc, .spotlight");
					if (!el) return;
					const r = el.getBoundingClientRect();
					el.style.setProperty("--mx", `${e.clientX - r.left}px`);
					el.style.setProperty("--my", `${e.clientY - r.top}px`);
				}, { passive: true });
			})();
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
