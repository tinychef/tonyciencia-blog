---
interface Props {
	title?: string;
	description?: string;
	source?: string;
}

const {
	title = "Obtén recursos gratuitos",
	description = "Plantillas, checklists y guías listas para usar en tu negocio. Directo a tu correo, sin relleno.",
	source = "home",
} = Astro.props;
---

<div class="email-capture">
	<h2 class="capture-title">{title}</h2>
	<p class="capture-desc">{description}</p>

	<form class="capture-form" data-source={source}>
		<input type="email" name="email" required placeholder="tu@email.com" aria-label="Tu email" class="capture-input" />
		<button type="submit" class="tc-btn tc-btn--primary capture-submit">Recibir</button>
	</form>
	<p class="capture-status" role="status" aria-live="polite"></p>
</div>

<script>
	const CAPTURE_ENDPOINT = "https://tonyciencia-email-capture.antonioduquejuliao.workers.dev";

	document.querySelectorAll<HTMLFormElement>(".capture-form").forEach((form) => {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const input = form.querySelector<HTMLInputElement>(".capture-input");
			const status = form.parentElement?.querySelector<HTMLElement>(".capture-status");
			const submitBtn = form.querySelector<HTMLButtonElement>(".capture-submit");
			if (!input || !status || !submitBtn) return;

			const email = input.value.trim();
			submitBtn.disabled = true;
			status.textContent = "Enviando...";

			try {
				const res = await fetch(CAPTURE_ENDPOINT, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ email, source: form.dataset.source ?? "home" }),
				});
				if (!res.ok) throw new Error("request_failed");
				status.textContent = "Listo — revisa tu correo.";
				form.reset();
			} catch {
				status.textContent = "Algo falló. Intenta de nuevo en un momento.";
			} finally {
				submitBtn.disabled = false;
			}
		});
	});
</script>

<style>
	.email-capture {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		padding: clamp(1.5rem, 4vw, 2.25rem);
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-xl);
		background: var(--color-bg-subtle);
	}

	.capture-title {
		margin: 0;
		font-size: clamp(1.35rem, 2.8vw, 1.75rem);
		letter-spacing: -0.03em;
	}

	.capture-desc {
		max-width: 48ch;
		margin: 0;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}

	.capture-form {
		display: flex;
		gap: var(--spacing-2);
		width: 100%;
		margin-top: var(--spacing-3);
	}

	.capture-input {
		flex: 1;
		min-width: 0;
		height: 44px;
		padding: 0 1.1rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: inherit;
		font-size: var(--font-size-sm);
		transition: border-color 160ms ease;
	}

	.capture-input::placeholder {
		color: var(--color-muted);
	}

	.capture-input:focus-visible {
		border-color: var(--color-text-secondary);
		outline: none;
	}

	.capture-status {
		min-height: 1.2em;
		margin: 0;
		color: var(--color-text-secondary);
		font-size: var(--font-size-xs);
	}

	@media (max-width: 480px) {
		.capture-form {
			flex-direction: column;
		}
	}
</style>
