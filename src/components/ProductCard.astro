---
interface Props {
	name: string;
	tagline: string;
	ctaLabel: string;
	ctaHref: string;
	accent: "pink" | "cyan" | "purple" | "orange";
}

const { name, tagline, ctaLabel, ctaHref, accent } = Astro.props;

// Peitho usa texto blanco sobre pink/purple/orange (más saturados) e ink
// sobre cyan/amarillo (más claros) — mismo criterio de contraste, no arbitrario.
const badgeText = accent === "pink" || accent === "purple" || accent === "orange" ? "#fff" : "#1d1c10";
---

<article class="product-card" style={`--accent: var(--color-neo-${accent}); --badge-text: ${badgeText};`}>
	<div class="product-badge">Producto propio</div>
	<h3 class="product-name">{name}</h3>
	<p class="product-tagline">{tagline}</p>
	<a href={ctaHref} target="_blank" rel="noopener noreferrer" class="product-cta tc-btn tc-btn--primary">
		{ctaLabel}
	</a>
</article>

<style>
	.product-card {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
		padding: clamp(1.75rem, 3vw, 2.5rem);
		background: var(--color-bg);
		border: var(--border-width-thick) solid var(--color-border);
		box-shadow: var(--shadow-lg);
	}

	.product-badge {
		width: fit-content;
		padding: 0.3rem 0.7rem;
		background: var(--accent);
		color: var(--badge-text);
		font-family: var(--font-mono);
		font-size: var(--font-size-2xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		border: 2px solid var(--color-border);
	}

	.product-name {
		font-size: clamp(2rem, 5vw, 2.75rem);
		margin: 0;
	}

	.product-tagline {
		color: var(--color-text-secondary);
		font-size: var(--font-size-md);
		line-height: 1.6;
		margin: 0;
		flex: 1;
	}

	.product-cta {
		align-self: flex-start;
		margin-top: var(--spacing-2);
	}
</style>
