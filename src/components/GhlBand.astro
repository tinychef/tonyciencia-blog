---
const GHL_URL = "https://www.gohighlevel.com/highlevel-bootcamp?fp_ref=tony-ciencia-llc-57";
const GHL_LOGO = "https://images.leadconnectorhq.com/image/f_webp/q_80/r_1200/u_https://assets.cdn.filesafe.space/knES3eSWYIsc5YSZ3YLl/media/68dc14d7a969ba71daf21593.png";
---

<section class="ghl-band">
	<div class="tc-shell ghl-inner">
		<img src={GHL_LOGO} alt="GoHighLevel" class="ghl-logo" width="160" height="40" loading="lazy" />
		<p class="ghl-copy">Automatiza tu CRM, tus embudos y tu mensajería desde una sola plataforma.</p>
		<a href={GHL_URL} target="_blank" rel="noopener noreferrer" class="tc-btn tc-btn--primary">
			Empieza gratis con GoHighLevel →
		</a>
	</div>
</section>

<style>
	.ghl-band {
		padding: clamp(2.5rem, 5vw, 4rem) 0;
		background: var(--color-surface);
		border-top: var(--border-width-thick) solid var(--color-border);
		border-bottom: var(--border-width-thick) solid var(--color-border);
	}

	.ghl-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-6);
		flex-wrap: wrap;
		text-align: center;
	}

	.ghl-logo {
		height: 32px;
		width: auto;
		object-fit: contain;
	}

	.ghl-copy {
		margin: 0;
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
		max-width: 40ch;
	}
</style>
