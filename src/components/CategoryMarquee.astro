---
import type { Partner } from "../data/partners.generated";
import { accentAt } from "../utils/accents";

interface Row {
	category: string;
	partners: Partner[];
	direction: "left" | "right";
	durationSeconds: number;
}

interface Props {
	rows: Row[];
	sectionLabel?: string;
	catalogHref?: string;
	catalogLabel?: string;
}

const { rows, sectionLabel = "Herramientas que recomendamos", catalogHref, catalogLabel = "Ver el catálogo completo →" } = Astro.props;
---

<section class="category-marquee" aria-label={sectionLabel}>
	<div class="marquee-heading">
		<p class="marquee-label">{sectionLabel}</p>
		{catalogHref && <a href={catalogHref} class="marquee-catalog-link">{catalogLabel}</a>}
	</div>

	{rows.map((row, rowIndex) => (
		<div class={`marquee-row${rowIndex === 0 ? " is-open" : ""}`} style={`--accent: var(--color-neo-${accentAt(rowIndex)});`}>
			<button
				type="button"
				class="row-header"
				aria-expanded={rowIndex === 0 ? "true" : "false"}
				aria-controls={`row-content-${rowIndex}`}
			>
				<span class="row-category">{row.category}</span>
				<span class="row-count">{row.partners.length} herramientas</span>
				<svg class="row-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</button>

			<div class="row-content" id={`row-content-${rowIndex}`}>
				<div class="row-content-inner">
					<div class="marquee-wrapper">
						<div
							class="track"
							style={`--duration: ${row.durationSeconds}s; --direction: ${row.direction === "right" ? "reverse" : "normal"};`}
						>
							{[...row.partners, ...row.partners].map((partner, i) => (
								<a
									href={partner.affiliateLink}
									target="_blank"
									rel="noopener noreferrer"
									class="tool-card"
									aria-label={`${partner.name} — ${row.category}`}
									aria-hidden={i >= row.partners.length ? "true" : undefined}
									tabindex={i >= row.partners.length ? -1 : 0}
								>
									<div class="tool-logo">
										<img
											src={partner.logoUrl}
											alt={`${partner.name} logo`}
											width="24"
											height="24"
											loading="lazy"
											decoding="async"
											onerror="this.style.display='none'"
										/>
									</div>
									<span class="tool-name">{partner.name}</span>
								</a>
							))}
						</div>
					</div>
				</div>
			</div>
		</div>
	))}
</section>

<script>
	document.querySelectorAll(".category-marquee .row-header").forEach((btn) => {
		btn.addEventListener("click", () => {
			const row = btn.closest(".marquee-row");
			if (!row) return;
			const expanded = btn.getAttribute("aria-expanded") === "true";
			btn.setAttribute("aria-expanded", String(!expanded));
			row.classList.toggle("is-open", !expanded);
		});
	});
</script>

<style>
	.category-marquee {
		padding: 2.5rem 0 3rem;
		border-top: var(--border-width-thick) solid var(--color-border);
		border-bottom: var(--border-width-thick) solid var(--color-border);
		background: var(--color-bg-subtle);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.marquee-heading {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-4);
		flex-wrap: wrap;
		margin: 0 var(--spacing-6) 0.5rem;
	}

	.marquee-label {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.marquee-catalog-link {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.marquee-catalog-link:hover {
		color: var(--color-accent-shadow);
	}

	.marquee-row {
		margin: 0 var(--spacing-6);
		border: 2px solid var(--color-border);
		background: var(--color-bg);
	}

	.row-header {
		width: 100%;
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		padding: 0.85rem 1rem;
		background: none;
		border: none;
		cursor: pointer;
		text-align: left;
		font-family: inherit;
		color: var(--color-text);
	}

	.row-category {
		font-family: var(--font-mono);
		font-size: var(--font-size-2xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
	}

	.row-count {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-2xs);
		color: var(--color-muted);
	}

	.row-arrow {
		flex-shrink: 0;
		transition: transform 250ms ease;
	}

	.marquee-row.is-open .row-arrow {
		transform: rotate(180deg);
	}

	/* Affordance: la flecha de las filas colapsadas rebota suave para
	   avisar que se pueden abrir, sin necesitar texto explicativo. */
	@keyframes arrow-pulse {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(3px); }
	}

	.marquee-row:not(.is-open) .row-arrow {
		animation: arrow-pulse 1.6s ease-in-out infinite;
	}

	.row-content {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 320ms ease;
		border-top: 0 solid var(--color-border);
	}

	.marquee-row.is-open .row-content {
		grid-template-rows: 1fr;
		border-top-width: 2px;
	}

	.row-content-inner {
		overflow: hidden;
		min-height: 0;
	}

	.marquee-wrapper {
		position: relative;
		overflow: hidden;
		width: 100%;
		display: flex;
		padding: 0.75rem 0;
		mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
	}

	.track {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.75rem;
		width: max-content;
		min-width: 100%;
		padding: 0.25rem 1rem;
		flex-shrink: 0;
		animation: scroll-x var(--duration, 34s) linear infinite;
		animation-direction: var(--direction, normal);
	}

	.marquee-wrapper:hover .track,
	.marquee-row:not(.is-open) .track {
		animation-play-state: paused;
	}

	@keyframes scroll-x {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	.tool-card {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.5rem 1rem 0.5rem 0.625rem;
		background: var(--color-bg);
		border: 2px solid var(--color-border);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--color-text);
		white-space: nowrap;
		flex-shrink: 0;
		transition: box-shadow 0.2s ease, transform 0.15s ease;
	}

	.tool-card:hover {
		box-shadow: 4px 4px 0 var(--accent);
		transform: translate(-2px, -2px);
	}

	.tool-logo {
		width: 24px;
		height: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.tool-logo img {
		width: 24px;
		height: 24px;
		object-fit: contain;
	}

	.tool-name {
		font-size: 0.8125rem;
		font-weight: 700;
		color: var(--color-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
		}

		.row-content {
			transition: none;
		}

		.marquee-row:not(.is-open) .row-arrow {
			animation: none;
		}

		.marquee-wrapper {
			overflow-x: auto;
			mask-image: none;
			-webkit-mask-image: none;
		}

		.track {
			min-width: unset;
		}
	}
</style>
