---
/** Un tramo de texto de Portable Text con sus marcas, aplicadas de afuera hacia adentro (recursivo). */
import PortableTextLink from "./PortableTextLink.astro";

interface Props {
	span: { _type?: string; text?: string; marks?: string[] };
	markDefs: Array<{ _key: string; _type: string; href?: string; blank?: boolean }>;
	marks?: string[];
}

const { span, markDefs } = Astro.props;
const marks = Astro.props.marks ?? (Array.isArray(span?.marks) ? span.marks : []);
const [mark, ...rest] = marks;
const text = typeof span?.text === "string" ? span.text : "";
const lines = text.split("\n");
const def = mark ? markDefs.find((d) => d._key === mark) : undefined;
const DECORATORS: Record<string, string> = { strong: "strong", em: "em", code: "code", underline: "u", "strike-through": "s" };
const Tag = mark ? DECORATORS[mark] : undefined;
---

{
	!mark ? (
		lines.map((line, i) => (i === 0 ? line : <Fragment><br />{line}</Fragment>))
	) : def?._type === "link" ? (
		<PortableTextLink node={{ markDef: def as any }}><Astro.self span={span} markDefs={markDefs} marks={rest} /></PortableTextLink>
	) : Tag ? (
		<Tag><Astro.self span={span} markDefs={markDefs} marks={rest} /></Tag>
	) : (
		<Astro.self span={span} markDefs={markDefs} marks={rest} />
	)
}
