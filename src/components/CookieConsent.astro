---
import { getLangFromUrl, useTranslations } from "../i18n/locales";

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
const cookiePolicyUrl = locale === "en" ? "/en/legal/cookies-en" : "/legal/cookies";
const rejectLabel = locale === "en" ? "Reject" : "Rechazar";
---

<div class="cookie-consent" id="cookie-consent" role="alert" aria-live="polite" hidden>
	<div class="cookie-inner">
		<p class="cookie-message">{t("cookies.message")}</p>
		<div class="cookie-actions">
			<a href={cookiePolicyUrl} class="cookie-link">{t("cookies.learnMore")}</a>
			<button type="button" class="cookie-reject" id="cookie-reject-btn">
				{rejectLabel}
			</button>
			<button type="button" class="cookie-accept" id="cookie-accept-btn">
				{t("cookies.accept")}
			</button>
		</div>
	</div>
</div>

<script>
	// Consent gate for third-party scripts (Analytics.astro reads this cookie
	// before deciding whether to grant Google Consent Mode / Meta Pixel consent).
	// Values: "accepted" | "rejected". No cookie yet = undecided.
	const COOKIE_NAME = "cookie_consent";

	function setConsentCookie(value: "accepted" | "rejected") {
		const secure = location.protocol === "https:" ? "; Secure" : "";
		document.cookie = `${COOKIE_NAME}=${value}; path=/; max-age=31536000; SameSite=Lax${secure}`;
		window.dispatchEvent(new CustomEvent("tc:consent", { detail: { value } }));
	}

	const banner = document.getElementById("cookie-consent");
	const acceptBtn = document.getElementById("cookie-accept-btn");
	const rejectBtn = document.getElementById("cookie-reject-btn");

	if (banner && acceptBtn && rejectBtn) {
		if (!document.cookie.includes(`${COOKIE_NAME}=`)) {
			banner.hidden = false;
		}

		acceptBtn.addEventListener("click", () => {
			setConsentCookie("accepted");
			banner.hidden = true;
		});

		rejectBtn.addEventListener("click", () => {
			setConsentCookie("rejected");
			banner.hidden = true;
		});
	}
</script>

<style>
	.cookie-consent {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 200;
		background: var(--glass-bg);
		border-top: 2px solid var(--glass-border);
		padding: var(--spacing-4) var(--spacing-6);
		animation: slideUp 400ms ease;
	}

	@keyframes slideUp {
		from { transform: translateY(100%); opacity: 0; }
		to { transform: translateY(0); opacity: 1; }
	}

	.cookie-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	.cookie-message {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin: 0;
	}

	.cookie-actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
	}

	.cookie-link {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.cookie-link:hover {
		color: var(--color-text);
	}

	.cookie-reject,
	.cookie-accept {
		padding: 8px 20px;
		border-radius: var(--radius-pill);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		cursor: pointer;
		transition: all 200ms ease;
	}

	.cookie-reject {
		background: transparent;
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}

	.cookie-reject:hover {
		border-color: var(--color-text);
	}

	.cookie-accept {
		background: var(--color-accent);
		color: var(--color-on-accent, #fff);
		border: 1px solid transparent;
	}

	.cookie-accept:hover {
		background: var(--color-accent-hover);
		transform: translateY(-1px);
	}
</style>
