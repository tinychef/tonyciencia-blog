---
interface Props {
	imgSrc: string;
	imgAlt: string;
	label?: string;
}

const { imgSrc, imgAlt, label } = Astro.props;
---

<section class="partner-badge-band" aria-label={label}>
	<div class="tc-shell partner-badge-inner">
		<img src={imgSrc} alt={imgAlt} class="partner-badge-img" width="180" height="60" loading="lazy" />
	</div>
</section>

<style>
	.partner-badge-band {
		padding: var(--spacing-6) 0;
		border-bottom: 2px solid var(--color-border-subtle);
	}

	.partner-badge-inner {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.partner-badge-img {
		height: 40px;
		width: auto;
		object-fit: contain;
	}
</style>
