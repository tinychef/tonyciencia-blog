---
// Página legal compartida por /legal/[slug] (ES) y /en/legal/[slug] (EN).
// La resolución (repo primero, EmDash/D1 como respaldo) la hace resolveLegalPage
// en src/data/legal-page.ts, llamada desde cada página de ruta.
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { LEGAL_UPDATED, type LegalDoc } from "../../data/legal";

interface Props {
	locale: "es" | "en";
	slug: string;
	doc?: LegalDoc;
	cmsPage?: any;
}

const { locale, slug, doc, cmsPage } = Astro.props;

const title = doc?.title ?? cmsPage.data.title;
const updated = doc ? LEGAL_UPDATED : cmsPage.data.last_reviewed;
const updatedLabel = locale === "en" ? "Last updated" : "Última actualización";
const formatted = updated
	? new Date(`${String(updated).slice(0, 10)}T12:00:00Z`).toLocaleDateString(locale, {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;
---

<Base
	title={`${title} — Tony Ciencia`}
	description={doc?.intro ?? title}
	content={cmsPage ? { collection: "legal_pages", id: cmsPage.data.id, slug } : undefined}
>
	<article class="legal">
		<header class="legal-head">
			<p class="tc-eyebrow">Legal</p>
			<h1>{title}</h1>
			{formatted && <p class="legal-date">{updatedLabel}: {formatted}</p>}
		</header>

		{doc ? (
			<div class="legal-body">
				<p class="legal-intro">{doc.intro}</p>
				{doc.sections.map((section) => (
					<section>
						<h2>{section.heading}</h2>
						{section.paragraphs?.map((p) => <p>{p}</p>)}
						{section.list && (
							<ul>
								{section.list.map((item) => <li>{item}</li>)}
							</ul>
						)}
						{section.note && <p>{section.note}</p>}
					</section>
				))}
			</div>
		) : (
			<div class="legal-body">
				<PortableText value={cmsPage.data.content} />
			</div>
		)}
	</article>
</Base>

<style>
	.legal {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: clamp(4rem, 10vw, 7rem) var(--spacing-6) clamp(4rem, 8vw, 6rem);
	}

	.legal-head {
		padding-bottom: var(--spacing-8);
		margin-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.legal-head h1 {
		margin-top: var(--spacing-3);
		font-size: clamp(2.2rem, 6vw, 3.2rem);
		letter-spacing: -0.045em;
	}

	.legal-date {
		margin-top: var(--spacing-4);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.legal-intro {
		color: var(--color-text) !important;
		font-size: var(--font-size-md) !important;
	}

	.legal-body :global(h2) {
		margin: var(--spacing-10) 0 var(--spacing-3);
		font-size: var(--font-size-lg);
		letter-spacing: -0.02em;
	}

	.legal-body :global(p),
	.legal-body :global(li) {
		color: var(--color-text-secondary);
		font-size: var(--font-size-base);
		line-height: 1.75;
	}

	.legal-body :global(p) {
		margin-bottom: var(--spacing-4);
	}

	.legal-body :global(ul) {
		display: grid;
		gap: var(--spacing-2);
		margin: 0 0 var(--spacing-4);
		padding-left: 1.1rem;
	}

	.legal-body :global(li::marker) {
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.legal {
			padding-inline: var(--spacing-4);
		}
	}
</style>
