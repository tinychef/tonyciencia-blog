---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import ToolsStack from "../../components/ToolsStack.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { getStaticPosts } from "../../utils/static-posts";
import { partners } from "../../data/partners.generated";
import { isExternalService, services } from "../../data/services";
import { getLatestVideo, YOUTUBE_CHANNEL_URL } from "../../utils/youtube";

// Home bilingüe: / (es) y /en (en) comparten diseño; solo cambian los textos.
interface Props {
	locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;

const COPY = {
	es: {
		hello: "Hola, soy Tony",
		titleA: "IA aplicada",
		titleB: "que puedes usar hoy.",
		sub: "Creo herramientas de IA en español y te enseño a usarlas en mi canal.",
		book: "Agendar llamada",
		services: "Servicios",
		crmLabel: "CRM favorito 2026",
		crmCta: "Probar gratis",
		tools: "Herramientas que recomiendo",
		catalog: "Ver catálogo completo",
		radar: "Radar IA",
		seeAll: "Ver todo",
		closing: "Hablemos de tu operación.",
		contact: "/contacto",
		posts: "/posts",
		dateLocale: "es-ES",
		marketKicker: "Market Tony",
		marketTitle: "Herramientas de IA listas para usar",
		marketSub: "Agentes, skills y plantillas para anuncios, videos y automatización. Pago único, descarga inmediata.",
		marketCta: "Ir al Market",
		meKicker: "Conóceme",
		meTitle: "Mírame en acción",
		meSub: "Más de 2.600 personas aprenden IA conmigo en YouTube.",
		meSubscribe: "Suscribirme",
		meAbout: "Sobre mí",
		about: "/about",
		videoPlay: "Reproducir el video",
	},
	en: {
		hello: "Hi, I'm Tony",
		titleA: "Applied AI",
		titleB: "you can use today.",
		sub: "I build AI tools and teach how to use them on my channel (in Spanish).",
		book: "Book a call",
		services: "Services",
		crmLabel: "Favorite CRM 2026",
		crmCta: "Try it free",
		tools: "Tools I recommend",
		catalog: "",
		radar: "AI Radar",
		seeAll: "See all",
		closing: "Let's talk about your operation.",
		contact: "/en/contact",
		posts: "/en/posts",
		dateLocale: "en-US",
		marketKicker: "Market Tony (in Spanish)",
		marketTitle: "Ready-to-use AI tools",
		marketSub: "Agents, skills and templates for ads, videos and automation. One-time payment, instant download.",
		marketCta: "Visit the Market",
		meKicker: "Get to know me",
		meTitle: "Watch me in action",
		meSub: "2,600+ people learn AI with me on YouTube (in Spanish).",
		meSubscribe: "Subscribe",
		meAbout: "About me",
		about: "/en/about",
		videoPlay: "Play the video",
	},
}[locale];

// Las tres consultas van en paralelo (antes eran en serie: D1 → ajustes → YouTube).
const [{ entries: cmsPosts, cacheHint }, siteSettings, latestVideo] = await Promise.all([
	getEmDashCollection("posts", { locale }),
	getSiteSettings(),
	getLatestVideo(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(siteSettings);

Astro.cache.set(cacheHint);

const staticPosts = getStaticPosts(locale);
const cmsSlugs = new Set(cmsPosts.map((post) => post.id));
const posts = [...staticPosts.filter((post) => !cmsSlugs.has(post.id)), ...cmsPosts] as any[];

const latestPosts = posts
	.toSorted((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
	.slice(0, 4);

const formatDate = (date: Date | null | undefined) =>
	date?.toLocaleDateString(COPY.dateLocale, { day: "numeric", month: "short", year: "numeric" });

const GHL_URL = "https://www.gohighlevel.com/highlevel-bootcamp?fp_ref=tony-ciencia-llc-57";


// Portadas de la puerta del Market (copias livianas en public/assets/market/; el Market es otro Worker en /market).
const MARKET_COVERS = ["anuncios-infinitos", "specreel", "cutpilot"];

// Carruseles curados — 6 categorías más relevantes para el ICP B2B. El catálogo
// completo vive en /herramientas (solo ES).
const CURATED_CATEGORIES = [
	"CRM y Ventas",
	"Marketing y Funnels",
	"Email Marketing y Ventas por Correo",
	"IA — Agentes y Automatización",
	"Productividad y Gestión de Proyectos",
	"Comunicación — Telefonía y Atención",
];

const CATEGORY_LABELS_EN: Record<string, string> = {
	"CRM y Ventas": "CRM & Sales",
	"Marketing y Funnels": "Marketing & Funnels",
	"Email Marketing y Ventas por Correo": "Email Marketing",
	"IA — Agentes y Automatización": "AI — Agents & Automation",
	"Productividad y Gestión de Proyectos": "Productivity & Project Management",
	"Comunicación — Telefonía y Atención": "Communication — Phone & Support",
};

const toolRows = CURATED_CATEGORIES.map((category, index) => ({
	category,
	partners: partners.filter((p) => p.category === category),
	direction: (index % 2 === 0 ? "left" : "right") as "left" | "right",
	durationSeconds: 34 + (index % 3) * 4,
})).filter((row) => row.partners.length > 0);
---

<Base title={siteTitle} description={locale === "en" ? "AI · Automation · Growth" : siteTagline}>
	<!-- Arriba solo dos caminos: el Market (principal) y conocer a Tony. Todo lo demás va más abajo. -->
	<section class="hero">
		<div class="tc-shell">
			<div class="hero-intro">
				<p class="hero-hello"><span class="hero-wave" aria-hidden="true">👋</span> {COPY.hello}</p>
				<h1 class="hero-title">
					{COPY.titleA}<br />
					<span class="tc-gradient-text">{COPY.titleB}</span>
				</h1>
				<p class="hero-sub">{COPY.sub}</p>
			</div>

			<div class="doors">
				<a href="/market" class="door door--market" hreflang={locale === "en" ? "es" : undefined}>
					<span class="door-media door-media--market" aria-hidden="true">
						{MARKET_COVERS.map((slug, i) => (
							<img src={`/assets/market/${slug}.webp`} alt="" width="800" height="500" class={`door-cover door-cover--${i + 1}`} fetchpriority={i === 0 ? "high" : undefined} />
						))}
					</span>
					<span class="door-body">
						<span class="door-kicker">{COPY.marketKicker}</span>
						<strong class="door-title">{COPY.marketTitle}</strong>
						<span class="door-text">{COPY.marketSub}</span>
						<span class="tc-btn tc-btn--primary door-cta">{COPY.marketCta} <span aria-hidden="true">→</span></span>
					</span>
				</a>

				<div class="door door--me">
					<div class="door-media yt-facade" data-yt={latestVideo.id}>
						<a href={`https://www.youtube.com/watch?v=${latestVideo.id}`} target="_blank" rel="noopener" aria-label={`${COPY.videoPlay}: ${latestVideo.title}`}>
							<img src={`https://i.ytimg.com/vi/${latestVideo.id}/hqdefault.jpg`} alt="" width="480" height="360" />
							<span class="yt-facade__shade" aria-hidden="true"></span>
							<span class="yt-facade__play" aria-hidden="true">
								<svg viewBox="0 0 68 48" width="60" height="42"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00" /><path d="m45 24-18-10v20z" fill="#fff" /></svg>
							</span>
							<span class="yt-facade__title">{latestVideo.title}</span>
						</a>
					</div>
					<div class="door-body">
						<span class="door-kicker">{COPY.meKicker} · YouTube</span>
						<strong class="door-title">{COPY.meTitle}</strong>
						<span class="door-text">{COPY.meSub}</span>
						<span class="door-actions">
							<a href={`${YOUTUBE_CHANNEL_URL}?sub_confirmation=1`} class="tc-btn tc-btn--secondary" target="_blank" rel="noopener">{COPY.meSubscribe}</a>
							<a href={COPY.about} class="door-link">{COPY.meAbout} →</a>
						</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="tc-section block" id="servicios" data-reveal>
		<div class="tc-column">
			<h2 class="block-title">{COPY.services}</h2>
			<ul class="line-list">
				{services.map((service, index) => (
					<li>
						<a
							href={service.href}
							target={isExternalService(service) ? "_blank" : undefined}
							rel={isExternalService(service) ? "noopener" : undefined}
							class:list={["line-item", { "has-mascot": service.id === "merkhify" }]}
							data-market-v2={service.href.startsWith("/market/") ? COPY.contact : undefined}
						>
							<span class="line-index">{String(index + 1).padStart(2, "0")}</span>
							<span class="line-main">
								<strong>{service.name}</strong>
								<span>{service.summary[locale]}</span>
							</span>
							{service.id === "merkhify" && (
								<img src="/assets/services/merkhify-mascota.webp" alt="" class="merkhify-mascot home-mascot" width="120" height="120" loading="lazy" />
							)}
							<span class="line-arrow" aria-hidden="true">{isExternalService(service) ? "↗" : "→"}</span>
						</a>
					</li>
				))}
			</ul>

			<a href={GHL_URL} target="_blank" rel="sponsored noopener" class="pick pick--crm">
				<span class="pick__label">{COPY.crmLabel}</span>
				<img src="/assets/partners/highlevel-white.webp" alt="HighLevel" class="pick__logo pick__logo--dark" width="480" height="108" loading="lazy" />
				<img src="/assets/partners/highlevel-blue.webp" alt="" aria-hidden="true" class="pick__logo pick__logo--light" width="480" height="108" loading="lazy" />
				<span class="pick__cta">{COPY.crmCta} <span aria-hidden="true">↗</span></span>
			</a>
		</div>
	</section>

	<ToolsStack
		rows={toolRows}
		title={COPY.tools}
		catalogHref={locale === "es" ? "/herramientas" : undefined}
		catalogLabel={COPY.catalog}
		categoryLabels={locale === "en" ? CATEGORY_LABELS_EN : undefined}
	/>

	<section class="tc-section block" data-reveal>
		<div class="tc-column">
			<div class="block-head">
				<h2 class="block-title">{COPY.radar}</h2>
				<a href={COPY.posts} class="block-link">{COPY.seeAll}</a>
			</div>
			{latestPosts.length > 0 && (
				<ul class="line-list">
					{latestPosts.map((post) => (
						<li>
							<a href={`${COPY.posts}/${post.id}`} class="line-item">
								<span class="line-main">
									<strong>{post.data.title}</strong>
									{post.data.publishedAt && <time>{formatDate(post.data.publishedAt)}</time>}
								</span>
								<span class="line-arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</div>
	</section>

	<section class="tc-section block block--flush" data-reveal>
		<div class="tc-column">
			<EmailCapture locale={locale} source={locale === "en" ? "home-en" : "home"} />
		</div>
	</section>

	<section class="tc-section closing" data-reveal>
		<div class="tc-column">
			<h2 class="closing-title">{COPY.closing}</h2>
			<a href={COPY.contact} class="tc-btn tc-btn--primary">{COPY.book}</a>
		</div>
	</section>
</Base>

<script>
	// Video de YouTube: el reproductor (y sus cookies) solo se carga al hacer clic.
	document.querySelectorAll<HTMLElement>("[data-yt]").forEach((box) => {
		box.querySelector("a")?.addEventListener("click", (e) => {
			const id = box.dataset.yt ?? "";
			if (!/^[\w-]{11}$/.test(id)) return;
			e.preventDefault();
			const frame = document.createElement("iframe");
			frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
			frame.title = "YouTube";
			frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
			frame.allowFullscreen = true;
			box.replaceChildren(frame);
		});
	});
</script>

<style>
	/* ── Hero: saludo + dos puertas (Market y conocer a Tony) ── */
	.hero {
		position: relative;
		overflow: hidden;
		padding: clamp(2.75rem, 7vw, 5rem) 0 clamp(3rem, 7vw, 5rem);
	}

	/* Aurora suave detrás del titular */
	.hero::before {
		content: "";
		position: absolute;
		inset: -30% -20% auto;
		height: 140%;
		pointer-events: none;
		background:
			radial-gradient(30% 35% at 70% 30%, rgba(62, 106, 225, 0.2), transparent 70%),
			radial-gradient(25% 30% at 30% 70%, rgba(155, 92, 255, 0.14), transparent 70%),
			radial-gradient(20% 25% at 85% 75%, rgba(255, 61, 139, 0.1), transparent 70%);
		filter: blur(20px);
		animation: hero-aurora 18s ease-in-out infinite alternate;
	}

	.hero > :global(*) {
		position: relative;
	}

	@keyframes hero-aurora {
		to { transform: translate3d(-6%, 4%, 0) scale(1.08); }
	}

	.hero-intro {
		max-width: 46rem;
		animation: hero-in 800ms var(--ease-out) both;
	}

	.hero-hello {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px 6px 10px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-bg-subtle);
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		font-weight: 500;
	}

	.hero-wave {
		display: inline-block;
		transform-origin: 70% 70%;
		animation: hero-wave 2.4s ease-in-out 1s 2;
	}

	@keyframes hero-wave {
		0%, 60%, 100% { transform: rotate(0); }
		10%, 30% { transform: rotate(14deg); }
		20% { transform: rotate(-8deg); }
		40% { transform: rotate(-4deg); }
		50% { transform: rotate(10deg); }
	}

	.hero-title {
		margin-top: var(--spacing-5);
		font-size: clamp(2.5rem, 7vw, 4.4rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.hero-sub {
		max-width: 40ch;
		margin-top: var(--spacing-5);
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: 1.45;
		letter-spacing: -0.015em;
	}

	@keyframes hero-in {
		from { opacity: 0; transform: translateY(16px); }
	}

	/* Puertas: la del Market pesa más (columna más ancha y botón principal). */
	.doors {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		gap: var(--spacing-5);
		margin-top: clamp(2rem, 5vw, 3rem);
		animation: hero-in 800ms var(--ease-out) 140ms both;
	}

	.door {
		position: relative;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-xl);
		background: var(--color-bg-subtle);
		overflow: hidden;
		color: var(--color-text);
		text-decoration: none;
		transition: transform 300ms var(--ease-out), border-color 200ms ease, box-shadow 300ms ease;
	}

	.door:hover {
		transform: translateY(-3px);
		border-color: var(--color-border);
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
	}

	.door--market {
		border-color: color-mix(in srgb, #9b5cff 30%, var(--color-border-subtle));
	}

	.door--market:hover {
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(155, 92, 255, 0.35), 0 10px 60px -10px rgba(255, 61, 139, 0.35);
	}

	.door-media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	/* Portadas en abanico; se abren un poco al pasar el cursor. */
	.door-media--market {
		background:
			radial-gradient(60% 80% at 30% 20%, rgba(245, 228, 0, 0.18), transparent 70%),
			radial-gradient(60% 80% at 80% 80%, rgba(155, 92, 255, 0.25), transparent 70%),
			var(--color-surface);
	}

	.door-cover {
		position: absolute;
		width: 58%;
		height: auto;
		border-radius: 10px;
		border: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
		transition: transform 500ms var(--ease-out);
	}

	.door-cover--1 { left: 6%; top: 14%; transform: rotate(-7deg); z-index: 1; }
	.door-cover--2 { left: 37%; top: 8%; transform: rotate(5deg); z-index: 2; }
	.door-cover--3 { left: 22%; top: 40%; transform: rotate(-1deg); z-index: 3; }

	.door--market:hover .door-cover--1 { transform: rotate(-10deg) translate(-10px, -4px); }
	.door--market:hover .door-cover--2 { transform: rotate(8deg) translate(10px, -6px); }
	.door--market:hover .door-cover--3 { transform: rotate(0) translateY(-6px); }

	.door-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 8px;
		padding: clamp(1.1rem, 2.5vw, 1.5rem);
	}

	.door-kicker {
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.door-title {
		font-size: clamp(1.25rem, 2.4vw, 1.6rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.door-text {
		color: var(--color-text-secondary);
		line-height: 1.5;
	}

	.door-cta {
		align-self: flex-start;
		margin-top: auto;
		translate: 0 6px;
	}

	.door-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-4);
		margin-top: auto;
		translate: 0 6px;
	}

	.door-actions .tc-btn {
		width: auto;
	}

	.door-link {
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-decoration: none;
	}

	.door-link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 760px) {
		.doors {
			grid-template-columns: 1fr;
		}
	}

	/* Escritorio: titular en una línea e imágenes más bajas, para que las dos puertas
	   (con sus botones) entren completas en el primer pantallazo. */
	@media (min-width: 900px) {
		.hero {
			padding-top: clamp(2rem, 4vw, 3rem);
		}

		.hero-title {
			font-size: clamp(2.6rem, 4.6vw, 3.9rem);
		}

		.hero-intro {
			max-width: none;
		}

		.hero-sub {
			max-width: 62ch;
		}

		.hero-title br {
			display: none;
		}

		.hero-title .tc-gradient-text::before {
			content: " ";
		}

		.door .door-media {
			aspect-ratio: 2.3 / 1;
		}

		.door-cover {
			width: 50%;
		}

		.door-cover--1 { left: 8%; top: 12%; }
		.door-cover--2 { left: 42%; top: 6%; }
		.door-cover--3 { left: 25%; top: 34%; }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero::before, .hero-intro, .doors, .hero-wave { animation: none; }
		.door, .door-cover { transition: none; }
	}

	.block-sub {
		margin: calc(clamp(1.25rem, 3vw, 2rem) * -0.5) 0 var(--spacing-6);
		color: var(--color-text-secondary);
		max-width: 56ch;
		line-height: 1.55;
	}

	/* ── Mascota de Merkhify en la lista de servicios ── */
	.line-item {
		position: relative;
	}

	.home-mascot {
		right: 2.25rem;
		top: 50%;
		margin-top: -60px;
		width: 120px;
		height: 120px;
	}

	@media (hover: none) {
		.has-mascot .line-main {
			padding-right: 64px;
		}

		.home-mascot {
			right: 1.75rem;
			margin-top: -28px;
			width: 56px;
			height: 56px;
		}
	}

	/* ── Video de YouTube (fachada liviana) ── */
	.yt-facade {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #000;
	}

	.yt-facade a,
	.yt-facade :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.yt-facade img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease-out);
	}

	.yt-facade a:hover img {
		transform: scale(1.03);
	}

	.yt-facade__shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.75));
	}

	.yt-facade__play {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		transition: transform 200ms var(--ease-out);
	}

	.yt-facade a:hover .yt-facade__play {
		transform: translate(-50%, -50%) scale(1.1);
	}

	.yt-facade__title {
		position: absolute;
		left: 1.25rem;
		right: 1.25rem;
		bottom: 1rem;
		color: #fff;
		font-weight: 600;
		line-height: 1.3;
	}



	/* ── Marco de credencial (CRM favorito) ── */
	.pick {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
