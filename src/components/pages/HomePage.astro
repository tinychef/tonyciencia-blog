---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import ToolsStack from "../../components/ToolsStack.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { getStaticPosts } from "../../utils/static-posts";
import { partners } from "../../data/partners.generated";
import { services } from "../../data/services";

// Home bilingüe: / (es) y /en (en) comparten diseño; solo cambian los textos.
interface Props {
	locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;

const COPY = {
	es: {
		titleA: "Implementa IA.",
		titleB: "Avanza.",
		sub: "Automatizaciones y agentes de IA operando dentro de tu empresa.",
		partnerLabel: "Partners de Anthropic",
		partnerCta: "Ver programa",
		book: "Agendar llamada",
		seeServices: "Ver servicios",
		services: "Servicios",
		crmLabel: "CRM favorito 2026",
		crmCta: "Probar gratis",
		tools: "Herramientas que recomiendo",
		catalog: "Ver catálogo completo",
		radar: "Radar IA",
		seeAll: "Ver todo",
		closing: "Hablemos de tu operación.",
		contact: "/contacto",
		posts: "/posts",
		dateLocale: "es-ES",
	},
	en: {
		titleA: "Implement AI.",
		titleB: "Move forward.",
		sub: "Automations and AI agents running inside your company.",
		partnerLabel: "Anthropic Partners",
		partnerCta: "See program",
		book: "Book a call",
		seeServices: "See services",
		services: "Services",
		crmLabel: "Favorite CRM 2026",
		crmCta: "Try it free",
		tools: "Tools I recommend",
		catalog: "",
		radar: "AI Radar",
		seeAll: "See all",
		closing: "Let's talk about your operation.",
		contact: "/en/contact",
		posts: "/en/posts",
		dateLocale: "en-US",
	},
}[locale];

const { entries: cmsPosts, cacheHint } = await getEmDashCollection("posts", { locale });
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

Astro.cache.set(cacheHint);

const staticPosts = getStaticPosts(locale);
const cmsSlugs = new Set(cmsPosts.map((post) => post.id));
const posts = [...staticPosts.filter((post) => !cmsSlugs.has(post.id)), ...cmsPosts] as any[];

const latestPosts = posts
	.toSorted((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
	.slice(0, 4);

const formatDate = (date: Date | null | undefined) =>
	date?.toLocaleDateString(COPY.dateLocale, { day: "numeric", month: "short", year: "numeric" });

const GHL_URL = "https://www.gohighlevel.com/highlevel-bootcamp?fp_ref=tony-ciencia-llc-57";

// Carruseles curados — 6 categorías más relevantes para el ICP B2B. El catálogo
// completo vive en /herramientas (solo ES).
const CURATED_CATEGORIES = [
	"CRM y Ventas",
	"Marketing y Funnels",
	"Email Marketing y Ventas por Correo",
	"IA — Agentes y Automatización",
	"Productividad y Gestión de Proyectos",
	"Comunicación — Telefonía y Atención",
];

const CATEGORY_LABELS_EN: Record<string, string> = {
	"CRM y Ventas": "CRM & Sales",
	"Marketing y Funnels": "Marketing & Funnels",
	"Email Marketing y Ventas por Correo": "Email Marketing",
	"IA — Agentes y Automatización": "AI — Agents & Automation",
	"Productividad y Gestión de Proyectos": "Productivity & Project Management",
	"Comunicación — Telefonía y Atención": "Communication — Phone & Support",
};

const toolRows = CURATED_CATEGORIES.map((category, index) => ({
	category,
	partners: partners.filter((p) => p.category === category),
	direction: (index % 2 === 0 ? "left" : "right") as "left" | "right",
	durationSeconds: 34 + (index % 3) * 4,
})).filter((row) => row.partners.length > 0);
---

<Base title={siteTitle} description={siteTagline}>
	<section class="hero">
		<div class="tc-column">
			<h1 class="hero-title">
				{COPY.titleA}<br />
				<span class="tc-gradient-text">{COPY.titleB}</span>
			</h1>
			<p class="hero-sub">{COPY.sub}</p>

			<a href="https://claude.com/partners" target="_blank" rel="noopener" class="pick pick--partner">
				<span class="pick__label">{COPY.partnerLabel}</span>
				<span class="cpn">
					<img
						src="/assets/partners/claude-partner-network.webp"
						alt="Claude Partner Network"
						width="512"
						height="214"
						fetchpriority="high"
					/>
				</span>
				<span class="pick__cta">{COPY.partnerCta} <span aria-hidden="true">↗</span></span>
			</a>

			<div class="hero-actions">
				<a href={COPY.contact} class="tc-btn tc-btn--primary">{COPY.book}</a>
				<a href="#servicios" class="tc-btn tc-btn--secondary">{COPY.seeServices}</a>
			</div>
		</div>
	</section>

	<section class="tc-section block" id="servicios" data-reveal>
		<div class="tc-column">
			<h2 class="block-title">{COPY.services}</h2>
			<ul class="line-list">
				{services.map((service, index) => (
					<li>
						<a href={service.href} target="_blank" rel="noopener" class="line-item">
							<span class="line-index">{String(index + 1).padStart(2, "0")}</span>
							<span class="line-main">
								<strong>{service.name}</strong>
								<span>{service.summary[locale]}</span>
							</span>
							<span class="line-arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ul>

			<a href={GHL_URL} target="_blank" rel="sponsored noopener" class="pick pick--crm">
				<span class="pick__label">{COPY.crmLabel}</span>
				<img src="/assets/partners/highlevel-white.webp" alt="HighLevel" class="pick__logo pick__logo--dark" width="480" height="108" loading="lazy" />
				<img src="/assets/partners/highlevel-blue.webp" alt="" aria-hidden="true" class="pick__logo pick__logo--light" width="480" height="108" loading="lazy" />
				<span class="pick__cta">{COPY.crmCta} <span aria-hidden="true">↗</span></span>
			</a>
		</div>
	</section>

	<ToolsStack
		rows={toolRows}
		title={COPY.tools}
		catalogHref={locale === "es" ? "/herramientas" : undefined}
		catalogLabel={COPY.catalog}
		categoryLabels={locale === "en" ? CATEGORY_LABELS_EN : undefined}
	/>

	<section class="tc-section block" data-reveal>
		<div class="tc-column">
			<div class="block-head">
				<h2 class="block-title">{COPY.radar}</h2>
				<a href={COPY.posts} class="block-link">{COPY.seeAll}</a>
			</div>
			{latestPosts.length > 0 && (
				<ul class="line-list">
					{latestPosts.map((post) => (
						<li>
							<a href={`${COPY.posts}/${post.id}`} class="line-item">
								<span class="line-main">
									<strong>{post.data.title}</strong>
									{post.data.publishedAt && <time>{formatDate(post.data.publishedAt)}</time>}
								</span>
								<span class="line-arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</div>
	</section>

	<section class="tc-section block block--flush" data-reveal>
		<div class="tc-column">
			<EmailCapture locale={locale} source={locale === "en" ? "home-en" : "home"} />
		</div>
	</section>

	<section class="tc-section closing" data-reveal>
		<div class="tc-column">
			<h2 class="closing-title">{COPY.closing}</h2>
			<a href={COPY.contact} class="tc-btn tc-btn--primary">{COPY.book}</a>
		</div>
	</section>
</Base>

<script>
	(function () {
		const targets = document.querySelectorAll("[data-reveal]");
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		targets.forEach((target) => target.classList.add("reveal"));
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				});
			},
			{ threshold: 0.12 }
		);
		targets.forEach((target) => observer.observe(target));
	})();
</script>

<style>
	.hero {
		padding: clamp(6rem, 18vw, 11rem) 0 clamp(5rem, 12vw, 8rem);
	}

	.hero-title {
		font-size: clamp(3rem, 10vw, 5.75rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	.hero-sub {
		max-width: 34ch;
		margin-top: var(--spacing-6);
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: 1.45;
		letter-spacing: -0.015em;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-10);
	}

	/* ── Marcos de credenciales (partner Anthropic, CRM favorito) ── */
	.pick {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		text-decoration: none;
		transition: border-color 200ms ease, color 200ms ease;
	}

	.pick:hover {
		border-color: var(--color-border);
		color: var(--color-text-secondary);
	}

	.pick__label {
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-size: var(--font-size-2xs);
	}

	.pick__cta {
		margin-left: auto;
		white-space: nowrap;
	}

	.pick--partner {
		max-width: 520px;
		margin-top: var(--spacing-8);
	}

	.pick--crm {
		margin-top: var(--spacing-8);
	}

	.pick__logo {
		width: auto;
		height: 20px;
		opacity: 0.85;
		transition: opacity 200ms ease;
	}

	.pick:hover .pick__logo {
		opacity: 1;
	}

	.pick__logo--light {
		display: none;
	}

	:global(:root.light) .pick__logo--dark {
		display: none;
	}

	:global(:root.light) .pick__logo--light {
		display: block;
	}

	/* Badge oficial de Anthropic: no se recolorea ni deforma. La animación es
	   externa a la imagen: entrada suave + un destello que la recorre cada pocos
	   segundos, y un leve realce al pasar el cursor. */
	.cpn {
		position: relative;
		display: block;
		flex-shrink: 0;
		overflow: hidden;
		border-radius: 8px;
		animation: cpn-in 900ms var(--ease-out) 200ms both;
		transition: transform 300ms var(--ease-out), box-shadow 300ms ease;
	}

	.cpn img {
		display: block;
		width: auto;
		height: 44px;
	}

	.cpn::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.65) 50%, transparent 65%);
		transform: translateX(-120%);
		animation: cpn-sheen 5s ease-in-out 1.4s infinite;
		pointer-events: none;
	}

	.pick--partner:hover .cpn {
		transform: translateY(-2px) scale(1.03);
		box-shadow: 0 8px 24px -10px rgba(217, 119, 87, 0.55);
	}

	@keyframes cpn-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.96);
		}
	}

	@keyframes cpn-sheen {
		0% { transform: translateX(-120%); }
		30%, 100% { transform: translateX(120%); }
	}

	/* En móvil la fila completa sigue siendo el enlace; sobra el texto de acción */
	@media (max-width: 480px) {
		.pick__cta {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cpn,
		.cpn::after {
			animation: none;
		}
	}

	.block {
		border-top: 1px solid var(--color-border-subtle);
	}

	.block--flush {
		padding-top: 0;
		border-top: 0;
	}

	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-4);
	}

	.block-title {
		margin-bottom: clamp(1.25rem, 3vw, 2rem);
		font-size: clamp(1.6rem, 3.6vw, 2.4rem);
		letter-spacing: -0.035em;
	}

	.block-link {
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		text-decoration: none;
	}

	.block-link:hover {
		color: var(--color-text);
	}

	/* ── Lista de líneas: el patrón único de la home ── */
	.line-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border-subtle);
	}

	.line-list li {
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.line-item {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: 1.25rem 0;
		color: var(--color-text);
		text-decoration: none;
	}

	.line-index {
		flex-shrink: 0;
		width: 1.75rem;
		align-self: flex-start;
		padding-top: 0.2rem;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.line-main {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.line-main strong {
		font-size: var(--font-size-md);
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.35;
	}

	.line-main span,
	.line-main time {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.5;
	}

	.line-arrow {
		flex-shrink: 0;
		color: var(--color-muted);
		transition: transform 200ms var(--ease-out), color 200ms ease;
	}

	.line-item:hover .line-arrow {
		color: var(--color-text);
		transform: translateX(3px);
	}

	.closing {
		border-top: 1px solid var(--color-border-subtle);
		text-align: center;
	}

	.closing-title {
		margin-bottom: var(--spacing-8);
		font-size: clamp(2rem, 5vw, 3.2rem);
		letter-spacing: -0.045em;
	}

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 640px) {
		.hero-actions {
			flex-direction: column;
		}
	}
</style>
