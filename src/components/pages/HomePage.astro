---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import ToolsStack from "../../components/ToolsStack.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { getStaticPosts } from "../../utils/static-posts";
import { partners } from "../../data/partners.generated";
import { isExternalService, services } from "../../data/services";
import { getLatestVideo, YOUTUBE_CHANNEL_URL } from "../../utils/youtube";

// Home bilingüe: / (es) y /en (en) comparten diseño; solo cambian los textos.
interface Props {
	locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;

const COPY = {
	es: {
		titleA: "Implementa IA.",
		titleB: "Avanza.",
		sub: "Automatizaciones y agentes de IA operando dentro de tu empresa.",
		book: "Agendar llamada",
		seeServices: "Ver servicios",
		services: "Servicios",
		crmLabel: "CRM favorito 2026",
		crmCta: "Probar gratis",
		tools: "Herramientas que recomiendo",
		catalog: "Ver catálogo completo",
		radar: "Radar IA",
		seeAll: "Ver todo",
		closing: "Hablemos de tu operación.",
		contact: "/contacto",
		posts: "/posts",
		dateLocale: "es-ES",
		marketKicker: "Market Tony",
		marketTitle: "Herramientas de IA listas para usar",
		marketSub: "Agentes, skills y plantillas para crear anuncios, videos y automatizaciones. Pago único y descarga inmediata.",
		marketCta: "Ver el Market",
		marketSoon: "Próximamente",
		videoKicker: "YouTube",
		videoTitle: "Mírame en acción",
		videoSub: "Tutoriales de IA, automatización y n8n, paso a paso y en español.",
		videoCta: "Suscribirme al canal",
		videoPlay: "Reproducir el video",
	},
	en: {
		titleA: "Implement AI.",
		titleB: "Move forward.",
		sub: "Automations and AI agents running inside your company.",
		book: "Book a call",
		seeServices: "See services",
		services: "Services",
		crmLabel: "Favorite CRM 2026",
		crmCta: "Try it free",
		tools: "Tools I recommend",
		catalog: "",
		radar: "AI Radar",
		seeAll: "See all",
		closing: "Let's talk about your operation.",
		contact: "/en/contact",
		posts: "/en/posts",
		dateLocale: "en-US",
		marketKicker: "Market Tony (in Spanish)",
		marketTitle: "Ready-to-use AI tools",
		marketSub: "Agents, skills and templates to create ads, videos and automations. One-time payment, instant download.",
		marketCta: "Visit the Market",
		marketSoon: "Coming soon",
		videoKicker: "YouTube",
		videoTitle: "Watch me in action",
		videoSub: "AI, automation and n8n tutorials, step by step (in Spanish).",
		videoCta: "Subscribe to the channel",
		videoPlay: "Play the video",
	},
}[locale];

const { entries: cmsPosts, cacheHint } = await getEmDashCollection("posts", { locale });
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

Astro.cache.set(cacheHint);

const staticPosts = getStaticPosts(locale);
const cmsSlugs = new Set(cmsPosts.map((post) => post.id));
const posts = [...staticPosts.filter((post) => !cmsSlugs.has(post.id)), ...cmsPosts] as any[];

const latestPosts = posts
	.toSorted((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
	.slice(0, 4);

const formatDate = (date: Date | null | undefined) =>
	date?.toLocaleDateString(COPY.dateLocale, { day: "numeric", month: "short", year: "numeric" });

const GHL_URL = "https://www.gohighlevel.com/highlevel-bootcamp?fp_ref=tony-ciencia-llc-57";

const latestVideo = await getLatestVideo();

// Vitrina del Market (worker aparte en /market, mismo dominio). Sin precios aquí para que nunca queden desactualizados.
const MARKET_PICKS = [
	{ slug: "anuncios-infinitos", name: "Anuncios Infinitos", line: { es: "250+ prompts de anuncios con estrategia", en: "250+ ad prompts with strategy" } },
	{ slug: "specreel", name: "SpecReel", line: { es: "Videos 3D con Claude Code y Codex", en: "3D videos with Claude Code and Codex" } },
	{ slug: "cutpilot", name: "CutPilot", line: { es: "Edita videos con Claude Code", en: "Edit videos with Claude Code" }, soon: true },
];

// Carruseles curados — 6 categorías más relevantes para el ICP B2B. El catálogo
// completo vive en /herramientas (solo ES).
const CURATED_CATEGORIES = [
	"CRM y Ventas",
	"Marketing y Funnels",
	"Email Marketing y Ventas por Correo",
	"IA — Agentes y Automatización",
	"Productividad y Gestión de Proyectos",
	"Comunicación — Telefonía y Atención",
];

const CATEGORY_LABELS_EN: Record<string, string> = {
	"CRM y Ventas": "CRM & Sales",
	"Marketing y Funnels": "Marketing & Funnels",
	"Email Marketing y Ventas por Correo": "Email Marketing",
	"IA — Agentes y Automatización": "AI — Agents & Automation",
	"Productividad y Gestión de Proyectos": "Productivity & Project Management",
	"Comunicación — Telefonía y Atención": "Communication — Phone & Support",
};

const toolRows = CURATED_CATEGORIES.map((category, index) => ({
	category,
	partners: partners.filter((p) => p.category === category),
	direction: (index % 2 === 0 ? "left" : "right") as "left" | "right",
	durationSeconds: 34 + (index % 3) * 4,
})).filter((row) => row.partners.length > 0);
---

<Base title={siteTitle} description={locale === "en" ? "AI · Automation · Growth" : siteTagline}>
	<section class="hero">
		<div class="tc-column">
			<h1 class="hero-title">
				{COPY.titleA}<br />
				<span class="tc-gradient-text">{COPY.titleB}</span>
			</h1>
			<p class="hero-sub">{COPY.sub}</p>

			<div class="hero-actions">
				<a href={COPY.contact} class="tc-btn tc-btn--primary">{COPY.book}</a>
				<a href="#servicios" class="tc-btn tc-btn--secondary">{COPY.seeServices}</a>
			</div>
		</div>
	</section>

	<section class="tc-section block" id="servicios" data-reveal>
		<div class="tc-column">
			<h2 class="block-title">{COPY.services}</h2>
			<ul class="line-list">
				{services.map((service, index) => (
					<li>
						<a
							href={service.href}
							target={isExternalService(service) ? "_blank" : undefined}
							rel={isExternalService(service) ? "noopener" : undefined}
							class:list={["line-item", { "has-mascot": service.id === "merkhify" }]}
							data-market-v2={service.href.startsWith("/market/") ? COPY.contact : undefined}
						>
							<span class="line-index">{String(index + 1).padStart(2, "0")}</span>
							<span class="line-main">
								<strong>{service.name}</strong>
								<span>{service.summary[locale]}</span>
							</span>
							{service.id === "merkhify" && (
								<img src="/assets/services/merkhify-mascota.webp" alt="" class="merkhify-mascot home-mascot" width="120" height="120" loading="lazy" />
							)}
							<span class="line-arrow" aria-hidden="true">{isExternalService(service) ? "↗" : "→"}</span>
						</a>
					</li>
				))}
			</ul>

			<a href={GHL_URL} target="_blank" rel="sponsored noopener" class="pick pick--crm">
				<span class="pick__label">{COPY.crmLabel}</span>
				<img src="/assets/partners/highlevel-white.webp" alt="HighLevel" class="pick__logo pick__logo--dark" width="480" height="108" loading="lazy" />
				<img src="/assets/partners/highlevel-blue.webp" alt="" aria-hidden="true" class="pick__logo pick__logo--light" width="480" height="108" loading="lazy" />
				<span class="pick__cta">{COPY.crmCta} <span aria-hidden="true">↗</span></span>
			</a>
		</div>
	</section>

	<ToolsStack
		rows={toolRows}
		title={COPY.tools}
		catalogHref={locale === "es" ? "/herramientas" : undefined}
		catalogLabel={COPY.catalog}
		categoryLabels={locale === "en" ? CATEGORY_LABELS_EN : undefined}
	/>

	<section class="tc-section block market-teaser" data-reveal>
		<div class="tc-column">
			<div class="block-head">
				<div>
					<p class="tc-eyebrow">{COPY.marketKicker}</p>
					<h2 class="block-title">{COPY.marketTitle}</h2>
				</div>
				<a href="/market" class="block-link" hreflang={locale === "en" ? "es" : undefined}>{COPY.marketCta} →</a>
			</div>
			<p class="block-sub">{COPY.marketSub}</p>
			<ul class="market-picks">
				{MARKET_PICKS.map((p) => (
					<li>
						<a href={`/market/producto/${p.slug}`} class="market-pick" hreflang={locale === "en" ? "es" : undefined} data-market-v2={p.soon ? "hide" : undefined}>
							<span class="market-pick__media">
								<img src={`/assets/market/${p.slug}.webp`} alt="" width="800" height="500" loading="lazy" />
								{p.soon && <span class="market-pick__soon">{COPY.marketSoon}</span>}
							</span>
							<strong>{p.name}</strong>
							<span>{p.line[locale]}</span>
						</a>
					</li>
				))}
			</ul>
			<a href="/market" class="tc-btn tc-btn--primary market-cta" hreflang={locale === "en" ? "es" : undefined}>{COPY.marketCta}</a>
		</div>
	</section>

	<section class="tc-section block" data-reveal>
		<div class="tc-column">
			<div class="block-head">
				<div>
					<p class="tc-eyebrow">{COPY.videoKicker}</p>
					<h2 class="block-title">{COPY.videoTitle}</h2>
				</div>
				<a href={YOUTUBE_CHANNEL_URL} class="block-link" target="_blank" rel="noopener">@tonyciencia ↗</a>
			</div>
			<p class="block-sub">{COPY.videoSub}</p>
			<div class="yt-facade" data-yt={latestVideo.id}>
				<a href={`https://www.youtube.com/watch?v=${latestVideo.id}`} target="_blank" rel="noopener" aria-label={`${COPY.videoPlay}: ${latestVideo.title}`}>
					<img src={`https://i.ytimg.com/vi/${latestVideo.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
					<span class="yt-facade__shade" aria-hidden="true"></span>
					<span class="yt-facade__play" aria-hidden="true">
						<svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#f00" /><path d="m45 24-18-10v20z" fill="#fff" /></svg>
					</span>
					<span class="yt-facade__title">{latestVideo.title}</span>
				</a>
			</div>
			<a href={`${YOUTUBE_CHANNEL_URL}?sub_confirmation=1`} class="tc-btn tc-btn--secondary yt-subscribe" target="_blank" rel="noopener">{COPY.videoCta}</a>
		</div>
	</section>

	<section class="tc-section block" data-reveal>
		<div class="tc-column">
			<div class="block-head">
				<h2 class="block-title">{COPY.radar}</h2>
				<a href={COPY.posts} class="block-link">{COPY.seeAll}</a>
			</div>
			{latestPosts.length > 0 && (
				<ul class="line-list">
					{latestPosts.map((post) => (
						<li>
							<a href={`${COPY.posts}/${post.id}`} class="line-item">
								<span class="line-main">
									<strong>{post.data.title}</strong>
									{post.data.publishedAt && <time>{formatDate(post.data.publishedAt)}</time>}
								</span>
								<span class="line-arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</div>
	</section>

	<section class="tc-section block block--flush" data-reveal>
		<div class="tc-column">
			<EmailCapture locale={locale} source={locale === "en" ? "home-en" : "home"} />
		</div>
	</section>

	<section class="tc-section closing" data-reveal>
		<div class="tc-column">
			<h2 class="closing-title">{COPY.closing}</h2>
			<a href={COPY.contact} class="tc-btn tc-btn--primary">{COPY.book}</a>
		</div>
	</section>
</Base>

<script>
	// Video de YouTube: el reproductor (y sus cookies) solo se carga al hacer clic.
	document.querySelectorAll<HTMLElement>("[data-yt]").forEach((box) => {
		box.querySelector("a")?.addEventListener("click", (e) => {
			const id = box.dataset.yt ?? "";
			if (!/^[\w-]{11}$/.test(id)) return;
			e.preventDefault();
			const frame = document.createElement("iframe");
			frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
			frame.title = "YouTube";
			frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
			frame.allowFullscreen = true;
			box.replaceChildren(frame);
		});
	});
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding: clamp(6rem, 18vw, 11rem) 0 clamp(5rem, 12vw, 8rem);
	}

	/* Aurora suave detrás del titular */
	.hero::before {
		content: "";
		position: absolute;
		inset: -30% -20% auto;
		height: 140%;
		pointer-events: none;
		background:
			radial-gradient(30% 35% at 70% 30%, rgba(62, 106, 225, 0.22), transparent 70%),
			radial-gradient(25% 30% at 35% 60%, rgba(155, 92, 255, 0.16), transparent 70%),
			radial-gradient(20% 25% at 85% 70%, rgba(255, 61, 139, 0.1), transparent 70%);
		filter: blur(20px);
		animation: hero-aurora 18s ease-in-out infinite alternate;
	}

	.hero > :global(*) {
		position: relative;
	}

	@keyframes hero-aurora {
		to { transform: translate3d(-6%, 4%, 0) scale(1.08); }
	}

	.hero-title {
		animation: hero-in 900ms var(--ease-out) both;
	}

	.hero-sub {
		animation: hero-in 900ms var(--ease-out) 120ms both;
	}

	.hero-actions {
		animation: hero-in 900ms var(--ease-out) 240ms both;
	}

	@keyframes hero-in {
		from { opacity: 0; transform: translateY(18px); filter: blur(6px); }
	}

	@media (prefers-reduced-motion: reduce) {
		.hero::before, .hero-title, .hero-sub, .hero-actions { animation: none; }
	}

	.block-sub {
		margin: calc(clamp(1.25rem, 3vw, 2rem) * -0.5) 0 var(--spacing-6);
		color: var(--color-text-secondary);
		max-width: 56ch;
		line-height: 1.55;
	}

	/* ── Mascota de Merkhify en la lista de servicios ── */
	.line-item {
		position: relative;
	}

	.home-mascot {
		right: 2.25rem;
		top: 50%;
		margin-top: -60px;
		width: 120px;
		height: 120px;
	}

	@media (hover: none) {
		.has-mascot .line-main {
			padding-right: 64px;
		}

		.home-mascot {
			right: 1.75rem;
			margin-top: -28px;
			width: 56px;
			height: 56px;
		}
	}

	/* ── Vitrina del Market ── */
	.market-picks {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-4);
	}

	.market-pick {
		display: grid;
		gap: 4px;
		color: var(--color-text);
		text-decoration: none;
	}

	.market-pick__media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border-subtle);
		margin-bottom: 8px;
		background: var(--color-surface);
	}

	.market-pick__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease-out);
	}

	.market-pick:hover .market-pick__media img {
		transform: scale(1.05);
	}

	.market-pick__soon {
		position: absolute;
		left: 8px;
		top: 8px;
		padding: 3px 9px;
		border-radius: var(--radius-pill);
		background: #d4ff3a;
		color: #111;
		font-size: 0.7rem;
		font-weight: 700;
	}

	.market-pick strong {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.market-pick > span:last-child {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
	}

	.market-cta {
		margin-top: var(--spacing-8);
	}

	@media (max-width: 640px) {
		.market-picks {
			grid-template-columns: 1fr;
		}
	}

	/* ── Video de YouTube (fachada liviana) ── */
	.yt-facade {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: #000;
		border: 1px solid var(--color-border-subtle);
	}

	.yt-facade a,
	.yt-facade :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.yt-facade img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease-out);
	}

	.yt-facade a:hover img {
		transform: scale(1.03);
	}

	.yt-facade__shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.75));
	}

	.yt-facade__play {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		transition: transform 200ms var(--ease-out);
	}

	.yt-facade a:hover .yt-facade__play {
		transform: translate(-50%, -50%) scale(1.1);
	}

	.yt-facade__title {
		position: absolute;
		left: 1.25rem;
		right: 1.25rem;
		bottom: 1rem;
		color: #fff;
		font-weight: 600;
		line-height: 1.3;
	}

	.yt-subscribe {
		margin-top: var(--spacing-6);
	}

	.hero-title {
		font-size: clamp(3rem, 10vw, 5.75rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	.hero-sub {
		max-width: 34ch;
		margin-top: var(--spacing-6);
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: 1.45;
		letter-spacing: -0.015em;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-10);
	}

	/* ── Marco de credencial (CRM favorito) ── */
	.pick {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-lg);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		text-decoration: none;
		transition: border-color 200ms ease, color 200ms ease;
	}

	.pick:hover {
		border-color: var(--color-border);
		color: var(--color-text-secondary);
	}

	.pick__label {
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		font-size: var(--font-size-2xs);
	}

	.pick__cta {
		margin-left: auto;
		white-space: nowrap;
	}

	.pick--crm {
		margin-top: var(--spacing-8);
	}

	.pick__logo {
		width: auto;
		height: 20px;
		opacity: 0.85;
		transition: opacity 200ms ease;
	}

	.pick:hover .pick__logo {
		opacity: 1;
	}

	.pick__logo--light {
		display: none;
	}

	:global(:root.light) .pick__logo--dark {
		display: none;
	}

	:global(:root.light) .pick__logo--light {
		display: block;
	}

	/* En móvil la fila completa sigue siendo el enlace; sobra el texto de acción */
	@media (max-width: 480px) {
		.pick__cta {
			display: none;
		}
	}

	.block {
		border-top: 1px solid var(--color-border-subtle);
	}

	.block--flush {
		padding-top: 0;
		border-top: 0;
	}

	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-4);
	}

	.block-title {
		margin-bottom: clamp(1.25rem, 3vw, 2rem);
		font-size: clamp(1.6rem, 3.6vw, 2.4rem);
		letter-spacing: -0.035em;
	}

	.block-link {
		white-space: nowrap;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		text-decoration: none;
	}

	.block-link:hover {
		color: var(--color-text);
	}

	/* ── Lista de líneas: el patrón único de la home ── */
	.line-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border-subtle);
	}

	.line-list li {
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.line-item {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: 1.25rem 0;
		color: var(--color-text);
		text-decoration: none;
	}

	.line-index {
		flex-shrink: 0;
		width: 1.75rem;
		align-self: flex-start;
		padding-top: 0.2rem;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.line-main {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
