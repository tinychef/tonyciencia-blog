---
import { getEmDashCollection, getEntryTerms, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import PostTitleCard from "../../components/PostTitleCard.astro";
import PartnerBadge from "../../components/PartnerBadge.astro";
import ProductCard from "../../components/ProductCard.astro";
import GhlBand from "../../components/GhlBand.astro";
import CategoryMarquee from "../../components/CategoryMarquee.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { getStaticPosts, getStaticTags } from "../../utils/static-posts";
import { partners } from "../../data/partners.generated";

// Home ES-only — ver src/components/pages/HomePageEn.astro para la home en inglés
// (intacta, sirve /en/). No hay ramas de idioma acá a propósito.
const locale = "es";

const { entries: cmsPosts, cacheHint } = await getEmDashCollection("posts", { locale });
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

Astro.cache.set(cacheHint);

const staticPosts = getStaticPosts(locale);
const cmsSlugs = new Set(cmsPosts.map((post) => post.id));
const posts = [...staticPosts.filter((post) => !cmsSlugs.has(post.id)), ...cmsPosts] as any[];

const sortedPosts = posts.toSorted((a, b) => {
	const dateA = a.data.publishedAt?.getTime() ?? 0;
	const dateB = b.data.publishedAt?.getTime() ?? 0;
	return dateB - dateA;
});

const featuredPost = sortedPosts[0];
const gridPosts = sortedPosts.slice(1, 5);

const featuredTags = featuredPost
	? getStaticTags(featuredPost).length > 0
		? getStaticTags(featuredPost)
		: (await getEntryTerms("posts", featuredPost.data.id, "tag")).map((tag) => ({ slug: tag.slug, label: tag.label }))
	: [];

const gridPostsWithTags = await Promise.all(
	gridPosts.map(async (post) => ({
		post,
		tags: getStaticTags(post).length > 0
			? getStaticTags(post)
			: (await getEntryTerms("posts", post.data.id, "tag")).map((tag) => ({ slug: tag.slug, label: tag.label })),
	}))
);

const formatDate = (date: Date | null | undefined) =>
	date?.toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" });

const operatingSystem = [
	["Auditar", "Mapeamos trabajo repetitivo, brechas de datos y decisiones listas para IA."],
	["Construir", "Desplegamos automatizaciones y agentes conectados a tus herramientas reales."],
	["Controlar", "Documentamos reglas, escalamiento y puntos de revisión humana."],
	["Escalar", "Medimos impacto y expandimos solo donde el caso de negocio es real."],
];

// Carrusel curado — 6 categorías más relevantes para el ICP B2B. El catálogo
// completo (139 partners activos / 29 categorías) vive en /herramientas.
const CURATED_CATEGORIES = [
	"CRM y Ventas",
	"Marketing y Funnels",
	"Email Marketing y Ventas por Correo",
	"IA — Agentes y Automatización",
	"Productividad y Gestión de Proyectos",
	"Comunicación — Telefonía y Atención",
];

const marqueeRows = CURATED_CATEGORIES.map((category, index) => ({
	category,
	partners: partners.filter((p) => p.category === category),
	direction: (index % 2 === 0 ? "left" : "right") as "left" | "right",
	durationSeconds: index % 2 === 0 ? 32 : 36,
}));
---

<Base title={siteTitle} description={siteTagline}>
	<section class="hero-2026">
		<div class="hero-grid-bg" aria-hidden="true"></div>
		<div class="tc-shell hero-shell">
			<div class="hero-copy">
				<span class="tc-eyebrow">Solo empresas</span>
				<h1 class="hero-title">
					Implementa IA,<br />
					<span class="tc-gradient-text">Avanza.</span>
				</h1>
				<p class="hero-subtitle">Muchos hablan de IA. Pocos construyen con ella.</p>
				<div class="hero-actions">
					<a href="/servicios" class="tc-btn tc-btn--primary">Ver servicios</a>
					<a href="/posts" class="tc-btn tc-btn--secondary">Leer el blog</a>
				</div>
			</div>
		</div>
	</section>

	<PartnerBadge
		imgSrc="https://www.claudeaimalaysia.com/uploads/claude_partner_network.png"
		imgAlt="Anthropic Claude Partner Network"
		label="Anthropic Claude Partner Network"
	/>

	<section class="tc-section services-2026">
		<div class="tc-shell">
			<div class="section-split">
				<div>
					<span class="tc-eyebrow">Solo Empresas</span>
					<h2 class="tc-section-title">Implementa IA en operaciones reales</h2>
				</div>
				<p class="tc-section-copy">Tres servicios para empresas que quieren pasar de probar herramientas a operar con sistemas de IA útiles, medibles y mantenibles.</p>
			</div>

			<div class="service-matrix">
				<a href="/servicios#automatizacion" class="matrix-card tc-card">
					<span class="matrix-index">01</span>
					<h3>Automatizaciones</h3>
					<p>Conectamos CRM, formularios, WhatsApp, email, hojas de cálculo y APIs para reducir trabajo manual y errores operativos.</p>
					<strong>Automatizar procesos →</strong>
				</a>
				<a href="/servicios#agentes-ia" class="matrix-card tc-card matrix-card--prime">
					<span class="matrix-index">02</span>
					<small>Solo Empresas</small>
					<h3>Agentes IA</h3>
					<p>Diseñamos agentes que atienden, clasifican, registran, consultan datos y escalan casos con reglas claras para tu equipo.</p>
					<strong>Crear agentes IA →</strong>
				</a>
				<a href="/servicios#mentoria" class="matrix-card tc-card">
					<span class="matrix-index">03</span>
					<h3>Mentoría</h3>
					<p>Acompañamos a dirección y equipos para elegir casos de uso, priorizar implementación y evitar gasto en IA sin retorno.</p>
					<strong>Solicitar mentoría →</strong>
				</a>
			</div>
		</div>
	</section>

	<section class="tc-section product-section">
		<div class="tc-shell">
			<div class="section-split">
				<div>
					<span class="tc-eyebrow">Suscripción</span>
					<h2 class="tc-section-title">Agentes que trabajan por vos.</h2>
				</div>
				<p class="tc-section-copy">Uno es un agente de atención al cliente. El otro es un agente de marketing.</p>
			</div>
			<div class="product-grid">
				<ProductCard
					name="Agente Mía"
					tagline="Atiende tu CRM, califica leads y agenda citas — para que ningún cliente se quede sin respuesta."
					ctaLabel="Hablar por WhatsApp →"
					ctaHref="https://wa.me/56976424523"
					accent="cyan"
				/>
				<ProductCard
					name="Agente Peitho"
					tagline="Tu estratega de marketing con IA — investiga tu marca, tu competencia y genera tu próxima campaña."
					ctaLabel="Conocer Peitho →"
					ctaHref="https://adsinfinitos.tonyciencia.com"
					accent="purple"
				/>
			</div>
		</div>
	</section>

	<GhlBand />

	<CategoryMarquee rows={marqueeRows} sectionLabel="Herramientas que recomendamos" catalogHref="/herramientas" />

	<section class="tc-section operating-section">
		<div class="tc-shell operating-grid">
			<div>
				<span class="tc-eyebrow">Método</span>
				<h2 class="tc-section-title">IA que funciona como sistema operativo.</h2>
			</div>
			<div class="operating-list">
				{operatingSystem.map(([title, copy], index) => (
					<div class="operating-item">
						<span>{String(index + 1).padStart(2, "0")}</span>
						<div>
							<h3>{title}</h3>
							<p>{copy}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="tc-section resources-section">
		<div class="tc-shell">
			<EmailCapture />
		</div>
	</section>

	<section class="tc-section blog-radar">
		<div class="tc-shell">
			<div class="section-split">
				<div>
					<span class="tc-eyebrow">Radar IA</span>
					<h2 class="tc-section-title">Últimos artículos</h2>
				</div>
				<a href="/posts" class="tc-btn tc-btn--secondary">Ver todos</a>
			</div>

			{sortedPosts.length === 0 ? (
				<div class="empty-state">
					<p>Sin artículos aún</p>
				</div>
			) : (
				<div class="blog-radar-grid">
					{featuredPost && (
						<article class="featured-article tc-card">
							<a href={`/posts/${featuredPost.id}`} class="featured-link">
								<div class="featured-media">
									<PostTitleCard title={featuredPost.data.title} variant="hero" />
								</div>
								<div class="featured-body">
									<div class="featured-meta">
										{featuredPost.data.publishedAt && <time>{formatDate(featuredPost.data.publishedAt)}</time>}
										<span>{getReadingTime(featuredPost.data.content as any)} min de lectura</span>
									</div>
									<h3>{featuredPost.data.title}</h3>
									{featuredPost.data.excerpt && <p>{featuredPost.data.excerpt}</p>}
									{featuredTags.length > 0 && (
										<div class="featured-tags">
											{featuredTags.slice(0, 3).map((tag) => <span>{tag.label}</span>)}
										</div>
									)}
								</div>
							</a>
						</article>
					)}
					<div class="post-stack">
						{gridPostsWithTags.map(({ post, tags }) => (
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								href={`/posts/${post.id}`}
								date={post.data.publishedAt ?? undefined}
								readingTime={getReadingTime(post.data.content as any)}
								tags={tags}
							/>
						))}
					</div>
				</div>
			)}
		</div>
	</section>

	<section class="final-cta">
		<div class="tc-shell">
			<div class="final-cta-card tc-card">
				<span class="tc-eyebrow">Orientación 1:1</span>
				<h2>¿Listo para implementar IA sin improvisar?</h2>
				<p>Agenda una orientación 1:1 gratuita de 30 minutos y te mostramos exactamente qué automatizaciones tienen más impacto para tu negocio.</p>
				<a href="/contacto" class="tc-btn tc-btn--primary">Agenda tu orientación 1:1 →</a>
			</div>
		</div>
	</section>
</Base>

<script>
	(function () {
		const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const targets = document.querySelectorAll(".service-matrix > *, .product-grid > *, .operating-item, .blog-radar-grid, .final-cta-card");
		targets.forEach((target) => target.classList.add("scroll-reveal"));
		if (prefersReduced) {
			targets.forEach((target) => target.classList.add("is-visible"));
			return;
		}
		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.classList.add("is-visible");
				observer.unobserve(entry.target);
			});
		}, { threshold: 0.14 });
		targets.forEach((target) => observer.observe(target));
	})();
</script>

<style>
	.hero-2026 {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: clamp(4.5rem, 9vw, 8rem) 0 clamp(4rem, 7vw, 6rem);
	}

	.hero-grid-bg {
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: var(--tc-grid);
		background-size: 46px 46px;
		mask-image: radial-gradient(ellipse 72% 62% at 50% 20%, black 0%, transparent 72%);
		opacity: 0.48;
	}

	.hero-shell {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-6);
		max-width: 900px;
	}

	.hero-title {
		font-size: clamp(3.2rem, 9vw, 7.4rem);
		line-height: 0.88;
		letter-spacing: -0.02em;
		max-width: 11ch;
	}

	.hero-subtitle {
		max-width: 62ch;
		color: var(--color-text-secondary);
		font-size: clamp(1.1rem, 1.4vw, 1.3rem);
		line-height: 1.75;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
	}

	.section-split {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(280px, 0.7fr);
		gap: var(--spacing-10);
		align-items: end;
		margin-bottom: clamp(2rem, 5vw, 4rem);
	}

	.services-2026 {
		background: var(--color-bg-subtle);
	}

	.service-matrix {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-5);
	}

	.matrix-card {
		display: flex;
		min-height: 390px;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(1.4rem, 2.5vw, 2rem);
		color: inherit;
		text-decoration: none;
		transition: transform var(--transition-base), box-shadow var(--transition-base);
	}

	.matrix-card:hover {
		transform: translate(-3px, -3px);
		box-shadow: var(--shadow-xl);
	}

	.matrix-card--prime {
		background: var(--color-accent-muted);
	}

	.matrix-index {
		color: var(--color-accent-shadow);
		font-family: var(--font-mono);
		font-weight: 900;
	}

	.matrix-card small {
		width: fit-content;
		padding: 0.3rem 0.65rem;
		background: var(--color-accent);
		color: var(--color-on-accent);
		font-family: var(--font-mono);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.matrix-card h3 {
		margin-top: auto;
		font-size: clamp(1.8rem, 4vw, 3rem);
	}

	.matrix-card p {
		margin: var(--spacing-4) 0 var(--spacing-6);
		color: var(--color-text-secondary);
		line-height: 1.65;
	}

	.matrix-card strong {
		color: var(--color-text);
		font-family: var(--font-mono);
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-5);
	}

	.operating-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.78fr) minmax(320px, 1fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
	}

	.operating-list {
		display: grid;
		gap: var(--spacing-3);
	}

	.operating-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--spacing-4);
		padding: var(--spacing-5);
		border: 2px solid var(--color-border);
		background: var(--color-bg);
	}

	.operating-item span {
		color: var(--color-accent-shadow);
		font-family: var(--font-mono);
		font-weight: 900;
	}

	.operating-item h3 {
		font-size: var(--font-size-xl);
	}

	.operating-item p {
		color: var(--color-text-secondary);
		line-height: 1.65;
	}

	.resources-section {
		background: var(--color-bg-subtle);
	}

	.blog-radar-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.9fr);
		gap: var(--spacing-6);
		align-items: start;
	}

	.featured-link {
		display: grid;
		color: inherit;
		text-decoration: none;
	}

	.featured-media {
		position: relative;
		z-index: 1;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 2px solid var(--color-border);
	}

	.featured-media :global(.title-render) {
		width: 100%;
		height: 100%;
		aspect-ratio: auto;
	}

	.featured-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--transition-slow);
	}

	.featured-link:hover img {
		transform: scale(1.035);
	}

	.featured-body {
		position: relative;
		z-index: 1;
		padding: clamp(1.4rem, 2.5vw, 2rem);
	}

	.featured-meta,
	.featured-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
	}

	.featured-body h3 {
		margin: var(--spacing-4) 0;
		font-size: clamp(1.8rem, 4vw, 3.2rem);
		line-height: 1;
	}

	.featured-body p {
		color: var(--color-text-secondary);
		line-height: 1.7;
	}

	.featured-tags {
		margin-top: var(--spacing-5);
	}

	.featured-tags span {
		padding: 0.28rem 0.65rem;
		border: 2px solid var(--color-border);
	}

	.post-stack {
		display: grid;
		gap: var(--spacing-4);
	}

	.final-cta {
		padding: 0 0 clamp(4rem, 8vw, 7rem);
	}

	.final-cta-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-5);
		padding: clamp(2rem, 6vw, 5rem);
		text-align: center;
	}

	.final-cta-card h2 {
		max-width: 760px;
		font-size: clamp(2.3rem, 6vw, 5rem);
		line-height: 0.95;
	}

	.final-cta-card p {
		max-width: 640px;
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: 1.7;
	}

	.scroll-reveal {
		opacity: 0;
		transform: translateY(24px);
		transition: opacity 0.7s ease, transform 0.7s ease;
	}

	.scroll-reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 980px) {
		.section-split,
		.operating-grid,
		.blog-radar-grid {
			grid-template-columns: 1fr;
		}

		.service-matrix,
		.product-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.hero-actions {
			flex-direction: column;
		}

		.matrix-card {
			min-height: 310px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-reveal,
		.matrix-card,
		.featured-media img {
			transition: none;
		}
		.scroll-reveal {
			opacity: 1;
			transform: none;
		}
		.matrix-card:hover,
		.tc-btn:hover {
			transform: none;
		}
	}
</style>
