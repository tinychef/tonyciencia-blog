---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import ToolsStack from "../../components/ToolsStack.astro";
import EmailCapture from "../../components/EmailCapture.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { getStaticPosts } from "../../utils/static-posts";
import { partners } from "../../data/partners.generated";
import { services } from "../../data/services";

// Home ES-only — ver src/components/pages/HomePageEn.astro para la home en inglés
// (intacta, sirve /en/). No hay ramas de idioma acá a propósito.
const locale = "es";

const { entries: cmsPosts, cacheHint } = await getEmDashCollection("posts", { locale });
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());

Astro.cache.set(cacheHint);

const staticPosts = getStaticPosts(locale);
const cmsSlugs = new Set(cmsPosts.map((post) => post.id));
const posts = [...staticPosts.filter((post) => !cmsSlugs.has(post.id)), ...cmsPosts] as any[];

const latestPosts = posts
	.toSorted((a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0))
	.slice(0, 4);

const formatDate = (date: Date | null | undefined) =>
	date?.toLocaleDateString("es-ES", { day: "numeric", month: "short", year: "numeric" });

// Carruseles curados — 6 categorías más relevantes para el ICP B2B. El catálogo
// completo vive en /herramientas.
const CURATED_CATEGORIES = [
	"CRM y Ventas",
	"Marketing y Funnels",
	"Email Marketing y Ventas por Correo",
	"IA — Agentes y Automatización",
	"Productividad y Gestión de Proyectos",
	"Comunicación — Telefonía y Atención",
];

const toolRows = CURATED_CATEGORIES.map((category, index) => ({
	category,
	partners: partners.filter((p) => p.category === category),
	direction: (index % 2 === 0 ? "left" : "right") as "left" | "right",
	durationSeconds: 34 + (index % 3) * 4,
})).filter((row) => row.partners.length > 0);
---

<Base title={siteTitle} description={siteTagline}>
	<section class="hero">
		<div class="tc-column">
			<h1 class="hero-title">
				Implementa IA.<br />
				<span class="tc-gradient-text">Avanza.</span>
			</h1>
			<p class="hero-sub">Automatizaciones y agentes de IA operando dentro de tu empresa.</p>
			<div class="hero-actions">
				<a href="/contacto" class="tc-btn tc-btn--primary">Agendar llamada</a>
				<a href="#servicios" class="tc-btn tc-btn--secondary">Ver servicios</a>
			</div>
			<p class="hero-credential">Anthropic Claude Partner Network</p>
		</div>
	</section>

	<section class="tc-section block" id="servicios" data-reveal>
		<div class="tc-column">
			<h2 class="block-title">Servicios</h2>
			<ul class="line-list">
				{services.map((service, index) => (
					<li>
						<a href={service.href} target="_blank" rel="noopener" class="line-item">
							<span class="line-index">{String(index + 1).padStart(2, "0")}</span>
							<span class="line-main">
								<strong>{service.name}</strong>
								<span>{service.summary}</span>
							</span>
							<span class="line-arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<ToolsStack rows={toolRows} catalogHref="/herramientas" />

	<section class="tc-section block" data-reveal>
		<div class="tc-column">
			<div class="block-head">
				<h2 class="block-title">Radar IA</h2>
				<a href="/posts" class="block-link">Ver todo</a>
			</div>
			{latestPosts.length > 0 && (
				<ul class="line-list">
					{latestPosts.map((post) => (
						<li>
							<a href={`/posts/${post.id}`} class="line-item">
								<span class="line-main">
									<strong>{post.data.title}</strong>
									{post.data.publishedAt && <time>{formatDate(post.data.publishedAt)}</time>}
								</span>
								<span class="line-arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			)}
		</div>
	</section>

	<section class="tc-section block block--flush" data-reveal>
		<div class="tc-column">
			<EmailCapture />
		</div>
	</section>

	<section class="tc-section closing" data-reveal>
		<div class="tc-column">
			<h2 class="closing-title">Hablemos de tu operación.</h2>
			<a href="/contacto" class="tc-btn tc-btn--primary">Agendar llamada</a>
		</div>
	</section>
</Base>

<script>
	(function () {
		const targets = document.querySelectorAll("[data-reveal]");
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		targets.forEach((target) => target.classList.add("reveal"));
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				});
			},
			{ threshold: 0.12 }
		);
		targets.forEach((target) => observer.observe(target));
	})();
</script>

<style>
	.hero {
		padding: clamp(6rem, 18vw, 11rem) 0 clamp(5rem, 12vw, 8rem);
	}

	.hero-title {
		font-size: clamp(3rem, 10vw, 5.75rem);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	.hero-sub {
		max-width: 34ch;
		margin-top: var(--spacing-6);
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: 1.45;
		letter-spacing: -0.015em;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
		margin-top: var(--spacing-10);
	}

	.hero-credential {
		margin-top: var(--spacing-10);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		letter-spacing: 0.01em;
	}

	.block {
		border-top: 1px solid var(--color-border-subtle);
	}

	.block--flush {
		padding-top: 0;
		border-top: 0;
	}

	.block-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-4);
	}

	.block-title {
		margin-bottom: clamp(1.25rem, 3vw, 2rem);
		font-size: clamp(1.6rem, 3.6vw, 2.4rem);
		letter-spacing: -0.035em;
	}

	.block-link {
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
		text-decoration: none;
	}

	.block-link:hover {
		color: var(--color-text);
	}

	/* ── Lista de líneas: el patrón único de la home ── */
	.line-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border-subtle);
	}

	.line-list li {
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.line-item {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: 1.25rem 0;
		color: var(--color-text);
		text-decoration: none;
	}

	.line-index {
		flex-shrink: 0;
		width: 1.75rem;
		align-self: flex-start;
		padding-top: 0.2rem;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.line-main {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.line-main strong {
		font-size: var(--font-size-md);
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.35;
	}

	.line-main span,
	.line-main time {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.5;
	}

	.line-arrow {
		flex-shrink: 0;
		color: var(--color-muted);
		transition: transform 200ms var(--ease-out), color 200ms ease;
	}

	.line-item:hover .line-arrow {
		color: var(--color-text);
		transform: translateX(3px);
	}

	.closing {
		border-top: 1px solid var(--color-border-subtle);
		text-align: center;
	}

	.closing-title {
		margin-bottom: var(--spacing-8);
		font-size: clamp(2rem, 5vw, 3.2rem);
		letter-spacing: -0.045em;
	}

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 640px) {
		.hero-actions {
			flex-direction: column;
		}
	}
</style>
