---
import Base from "../../layouts/Base.astro";
import { getLangFromUrl } from "../../i18n/locales";
import { services } from "../../data/services";

const locale = getLangFromUrl(Astro.url);

Astro.cache.set({ maxAge: 3600 });

const COPY = {
	es: {
		title: "Servicios IA para Empresas — Tony Ciencia",
		description: "ADS Performance, Merkhify y Anuncios Infinitos: pauta, agentes de IA y creativos para empresas que quieren crecer con sistemas, no con experimentos.",
		eyebrow: "Servicios",
		h1A: "Tres sistemas.",
		h1B: "Un objetivo: más clientes.",
		sub: "Cada servicio resuelve una parte del crecimiento: atraer, responder y convertir.",
		for: "Para",
		includes: "Incluye",
		closing: "¿No sabes cuál necesitas?",
		closingSub: "Agenda una llamada de 30 minutos y te decimos por dónde empezar.",
		book: "Agendar llamada",
		contact: "/contacto",
	},
	en: {
		title: "AI Services for Companies — Tony Ciencia",
		description: "ADS Performance, Merkhify and Anuncios Infinitos: ads, AI agents and creatives for companies that want to grow with systems, not experiments.",
		eyebrow: "Services",
		h1A: "Three systems.",
		h1B: "One goal: more customers.",
		sub: "Each service solves one part of growth: attract, respond and convert.",
		for: "For",
		includes: "Includes",
		closing: "Not sure which one you need?",
		closingSub: "Book a 30-minute call and we'll tell you where to start.",
		book: "Book a call",
		contact: "/en/contact",
	},
}[locale];
---

<Base title={COPY.title} description={COPY.description}>
	<section class="svc-hero">
		<div class="tc-column">
			<p class="tc-eyebrow">{COPY.eyebrow}</p>
			<h1>
				{COPY.h1A}<br />
				<span class="tc-gradient-text">{COPY.h1B}</span>
			</h1>
			<p class="svc-sub">{COPY.sub}</p>
		</div>
	</section>

	<div class="tc-column svc-list">
		{services.map((service, index) => (
			<article id={service.id} class="svc" data-reveal>
				<header class="svc-head">
					<span class="svc-index">{String(index + 1).padStart(2, "0")}</span>
					<h2>{service.name}</h2>
					<p class="svc-summary">{service.summary[locale]}</p>
				</header>

				<dl class="svc-meta">
					<div>
						<dt>{COPY.for}</dt>
						<dd>{service.audience[locale]}</dd>
					</div>
					<div>
						<dt>{COPY.includes}</dt>
						<dd>
							<ul>
								{service.includes[locale].map((item) => <li>{item}</li>)}
							</ul>
						</dd>
					</div>
				</dl>

				<a href={service.href} target="_blank" rel="noopener" class="tc-btn tc-btn--secondary">
					{service.cta[locale]} <span aria-hidden="true">↗</span>
				</a>
			</article>
		))}
	</div>

	<section class="tc-section svc-closing" data-reveal>
		<div class="tc-column">
			<h2>{COPY.closing}</h2>
			<p>{COPY.closingSub}</p>
			<a href={COPY.contact} class="tc-btn tc-btn--primary">{COPY.book}</a>
		</div>
	</section>
</Base>

<script>
	(function () {
		const targets = document.querySelectorAll("[data-reveal]");
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		targets.forEach((target) => target.classList.add("reveal"));
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					entry.target.classList.add("is-visible");
					observer.unobserve(entry.target);
				});
			},
			{ threshold: 0.12 }
		);
		targets.forEach((target) => observer.observe(target));
	})();
</script>

<style>
	.svc-hero {
		padding: clamp(5rem, 14vw, 9rem) 0 clamp(3rem, 8vw, 5rem);
	}

	.svc-hero h1 {
		margin-top: var(--spacing-4);
		font-size: clamp(2.6rem, 8vw, 4.6rem);
		line-height: 1.02;
		letter-spacing: -0.05em;
	}

	.svc-sub {
		max-width: 40ch;
		margin-top: var(--spacing-6);
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: 1.45;
	}

	.svc-list {
		display: grid;
	}

	.svc {
		display: grid;
		gap: var(--spacing-8);
		padding: clamp(3rem, 7vw, 4.5rem) 0;
		border-top: 1px solid var(--color-border-subtle);
		scroll-margin-top: calc(var(--nav-height, 64px) + 1rem);
	}

	.svc-head {
		display: grid;
		gap: var(--spacing-3);
	}

	.svc-index {
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-variant-numeric: tabular-nums;
	}

	.svc-head h2 {
		font-size: clamp(2rem, 5vw, 3rem);
		letter-spacing: -0.045em;
	}

	.svc-summary {
		color: var(--color-text-secondary);
		font-size: var(--font-size-lg);
		line-height: 1.45;
	}

	.svc-meta {
		display: grid;
		gap: var(--spacing-6);
		margin: 0;
	}

	.svc-meta > div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: var(--spacing-4);
	}

	.svc-meta dt {
		padding-top: 0.15rem;
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.svc-meta dd {
		margin: 0;
		color: var(--color-text);
		line-height: 1.6;
	}

	.svc-meta ul {
		display: grid;
		gap: var(--spacing-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.svc-meta li {
		padding-left: 1.1rem;
		position: relative;
		color: var(--color-text-secondary);
	}

	.svc-meta li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.svc .tc-btn {
		justify-self: start;
	}

	.svc-closing {
		border-top: 1px solid var(--color-border-subtle);
		text-align: center;
	}

	.svc-closing h2 {
		font-size: clamp(1.9rem, 5vw, 3rem);
		letter-spacing: -0.045em;
	}

	.svc-closing p {
		max-width: 44ch;
		margin: var(--spacing-4) auto var(--spacing-8);
		color: var(--color-text-secondary);
	}

	.reveal {
		opacity: 0;
		transform: translateY(16px);
		transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out);
	}

	.reveal.is-visible {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 640px) {
		.svc-meta > div {
			grid-template-columns: 1fr;
			gap: var(--spacing-2);
		}

		.svc .tc-btn {
			justify-self: stretch;
		}
	}
</style>
