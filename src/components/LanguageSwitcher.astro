---
import { getLangFromUrl, getAlternateLocale, getLocalePath } from "../i18n/locales";

interface Props {
	alternatePath?: string;
}

const { alternatePath } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const altPath = alternatePath || getLocalePath(Astro.url.pathname, getAlternateLocale(locale));

const options = [
	{ code: "es", label: "ES", name: "Español" },
	{ code: "en", label: "EN", name: "English" },
] as const;
---

<nav class="lang-switch" aria-label={locale === "es" ? "Idioma" : "Language"}>
	{options.map((option) =>
		option.code === locale ? (
			<span class="lang-option is-current" aria-current="true" lang={option.code} title={option.name}>{option.label}</span>
		) : (
			<a href={altPath} class="lang-option" hreflang={option.code} lang={option.code} title={option.name}>{option.label}</a>
		)
	)}
</nav>

<style>
	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		height: 36px;
		padding: 3px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background: var(--color-bg-subtle);
	}

	.lang-option {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 32px;
		height: 28px;
		padding: 0 0.5rem;
		border-radius: var(--radius-pill);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		transition: color 160ms ease, background 160ms ease;
	}

	a.lang-option:hover {
		color: var(--color-text);
	}

	/* Área táctil de 44px sin agrandar el control visible */
	@media (pointer: coarse) {
		.lang-option {
			position: relative;
		}

		.lang-option::after {
			content: "";
			position: absolute;
			inset: -8px -2px;
		}
	}

	.lang-option.is-current {
		background: var(--color-text);
		color: var(--color-bg);
	}
</style>
