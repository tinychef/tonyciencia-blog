---
// Botón flotante "Market Tony" → /market (tienda, Worker aparte: workers/market).
// Se incluye una sola vez en Base.astro, así aparece en todas las páginas del sitio.
// Mismo diseño que el del market (workers/market/public/market/static/market.css).
//
// No tapa contenido importante:
//  - deja un espaciador al final de la página para no cubrir el pie;
//  - en celular se esconde al bajar y reaparece al subir, al llegar al final o con foco de teclado;
//  - sube por encima del botón "volver arriba" de los posts y del banner de cookies.
const href = import.meta.env.PUBLIC_MARKET_URL || "/market";
---

<div class="market-fab-spacer" aria-hidden="true"></div>
<a href={href} class="market-fab" id="market-fab">
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
		<line x1="3" y1="6" x2="21" y2="6"></line>
		<path d="M16 10a4 4 0 0 1-8 0"></path>
	</svg>
	<span>Market Tony</span>
</a>

<script>
	(() => {
		const fab = document.getElementById("market-fab");
		if (!fab) return;
		const root = document.documentElement;

		// Banner de cookies (CookieConsent.astro): el botón se sube lo que mida el banner mientras se vea.
		const banner = document.getElementById("cookie-consent");
		const syncBanner = () => {
			const h = banner && !banner.hidden ? banner.offsetHeight : 0;
			root.style.setProperty("--market-fab-cookie", `${h}px`);
		};
		if (banner) {
			new MutationObserver(syncBanner).observe(banner, { attributes: true, attributeFilter: ["hidden"] });
			if ("ResizeObserver" in window) new ResizeObserver(syncBanner).observe(banner);
		}
		syncBanner();

		// En pantallas chicas: esconder al bajar, mostrar al subir / al final / con foco.
		const small = window.matchMedia("(max-width: 640px)");
		let lastY = window.scrollY;
		let queued = false;
		const update = () => {
			queued = false;
			const y = window.scrollY;
			const delta = y - lastY;
			const atEnd = y + window.innerHeight >= root.scrollHeight - 120;
			if (!small.matches || y < 120 || atEnd || delta < -6) fab.classList.remove("is-tucked");
			else if (delta > 6) fab.classList.add("is-tucked");
			lastY = y;
		};
		window.addEventListener(
			"scroll",
			() => {
				if (!queued) {
					queued = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		fab.addEventListener("focus", () => fab.classList.remove("is-tucked"));
	})();
</script>

<style>
	.market-fab {
		--market-fab-base: max(var(--spacing-6), env(safe-area-inset-bottom));
		position: fixed;
		right: max(var(--spacing-8), env(safe-area-inset-right));
		bottom: calc(var(--market-fab-base) + var(--market-fab-cookie, 0px));
		/* Debajo del header (100), el menú móvil (105) y el banner de cookies (200). */
		z-index: 98;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 18px 0 14px;
		border-radius: var(--radius-pill);
		background: var(--color-accent);
		color: var(--color-on-accent);
		border: 1px solid var(--color-border);
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: -0.005em;
		line-height: 1;
		text-decoration: none;
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
		transition: transform 200ms ease, opacity 200ms ease, background 160ms ease, bottom 200ms ease;
	}

	.market-fab:hover {
		background: var(--color-accent-hover);
		color: var(--color-on-accent);
	}

	.market-fab:focus-visible {
		outline: 2px solid var(--color-signal);
		outline-offset: 3px;
	}

	.market-fab svg {
		width: 18px;
		height: 18px;
		flex: none;
	}

	.market-fab:global(.is-tucked):not(:focus-visible) {
		transform: translateY(calc(100% + 32px));
		opacity: 0;
		pointer-events: none;
	}

	/* Botón "volver arriba" de los posts (44px en bottom: --spacing-8): el market se pone encima. */
	:global(body:has(.back-to-top.is-visible)) .market-fab {
		--market-fab-base: calc(var(--spacing-8) + 44px + 12px);
	}

	.market-fab-spacer {
		height: 72px;
	}

	@media (max-width: 640px) {
		.market-fab {
			--market-fab-base: max(var(--spacing-4), env(safe-area-inset-bottom));
			right: max(var(--spacing-4), env(safe-area-inset-right));
			padding: 0 14px 0 12px;
			font-size: 0.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.market-fab {
			transition: none;
		}
	}

	@media print {
		.market-fab,
		.market-fab-spacer {
			display: none;
		}
	}
</style>
