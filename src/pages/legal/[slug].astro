---
import LegalPage from "../../components/pages/LegalPage.astro";
import { resolveLegalPage } from "../../data/legal-page";

const result = await resolveLegalPage(Astro, "es");
if (result.kind === "redirect") return Astro.redirect("/404");
---

<LegalPage locale="es" slug={result.slug} doc={result.doc} cmsPage={result.cmsPage} />
