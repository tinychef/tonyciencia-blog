EMDASH_AUTH_SECRET=your-secret-here

# Analytics (src/components/Analytics.astro) — optional, gated by cookie consent.
# Leave empty locally; set as build vars in Cloudflare + GitHub Actions to go live.
PUBLIC_GA_ID=
PUBLIC_META_PIXEL_ID=

# Botón flotante "Market Tony" (src/components/MarketFab.astro). Opcional: por defecto "/market".
# En local, para probarlo contra el market de `workers/market` (pnpm dev): http://localhost:8787/market
PUBLIC_MARKET_URL=

# Las variables y secretos del market están en workers/market/.env.example (Worker aparte).
