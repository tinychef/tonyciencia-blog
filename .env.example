EMDASH_AUTH_SECRET=your-secret-here

# Analytics (src/components/Analytics.astro) — optional, gated by cookie consent
# (Consent Mode v2: everything denied until the visitor accepts the banner).
# Leave empty locally. To go live, set them as GitHub repository VARIABLES
# (Settings → Secrets and variables → Actions → Variables): deploy.yml passes
# them to `astro build`, which inlines them. Empty = that tag is not loaded.
# Google Tag Manager container, "GTM-XXXXXXX". If GA4 is configured inside GTM,
# leave PUBLIC_GA_ID empty so page views are not counted twice.
PUBLIC_GTM_ID=
PUBLIC_GA_ID=
PUBLIC_META_PIXEL_ID=

# Botón flotante "Market Tony" (src/components/MarketFab.astro). Opcional: por defecto "/market".
# En local, para probarlo contra el market de `workers/market` (pnpm dev): http://localhost:8787/market
PUBLIC_MARKET_URL=

# Las variables y secretos del market están en workers/market/.env.example (Worker aparte).
