{
  "name": "tonyciencia-market",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "sync:theme": "node scripts/sync-theme.mjs",
    "dev": "pnpm sync:theme && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply MARKET_DB --local",
    "db:seed:local": "node scripts/seed.mjs --local",
    "setup:local": "pnpm db:migrate:local && pnpm db:seed:local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node --test e2e/flujo-completo.test.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "deploy:preview": "node scripts/check-deploy.mjs preview && pnpm sync:theme && wrangler deploy --env preview",
    "deploy:staging": "node scripts/check-deploy.mjs staging && pnpm sync:theme && wrangler deploy --env staging",
    "deploy:production": "node scripts/check-deploy.mjs production && pnpm sync:theme && wrangler deploy --env production",
    "admin": "node scripts/admin-cli.mjs"
  },
  "dependencies": {
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "5.20261029.1",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  }
}
