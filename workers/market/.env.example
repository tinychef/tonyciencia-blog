# ═══════════════════════════════════════════════════════════════════════════
#  Market Tony — variables de configuración (REFERENCIA, no se lee automáticamente)
#
#  • VARIABLES (no secretas): viven en wrangler.jsonc → env.<entorno>.vars
#  • SECRETOS: NUNCA en el repo. Se guardan con:
#        pnpm wrangler secret put NOMBRE --env staging       (o production / preview)
#    (pnpm wrangler = wrangler con -c wrangler.jsonc; pega el valor cuando lo pida)
#  • Local (pnpm dev): copia .dev.vars.example a .dev.vars (ignorado por git).
# ═══════════════════════════════════════════════════════════════════════════

# ── Modo ───────────────────────────────────────────────────────────────────
# mock = maqueta (login falso, pago simulado, correos en /dev/correos, archivos de prueba)
# live = Google + Stripe + R2 + correo reales.
# MODE=mock con SITE_URL en tonyciencia.com → el Worker NO arranca (a propósito).
MODE=mock
# Origen público sin barra final. Producción: https://tonyciencia.com
SITE_URL=http://localhost:8787

# ── Pagos ──────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=stripe                 # único implementado; ver HANDOFF.md para Polar/Dodo
STRIPE_SECRET_KEY=                      # SECRETO. Primero sk_test_… (o restringida rk_test_…)
STRIPE_WEBHOOK_SECRET=                  # SECRETO. whsec_… del endpoint /market/webhooks/pagos
STRIPE_TAX_ENABLED=false                # Stripe Tax apagado por defecto (decisión pendiente)
STRIPE_TAX_CODE=                        # opcional, solo si se activa Stripe Tax
ALLOW_LIVE_PAYMENTS=false               # con una clave sk_live_ el Worker no arranca salvo "true"

# ── Login con Google ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                       # SECRETO (por prolijidad). Redirect: <SITE_URL>/market/auth/callback
GOOGLE_CLIENT_SECRET=                   # SECRETO

# ── Sesiones ───────────────────────────────────────────────────────────────
SESSION_SECRET=                         # SECRETO, ≥ 32 caracteres aleatorios: openssl rand -base64 48

# ── Administración ─────────────────────────────────────────────────────────
ADMIN_EMAIL=                            # SECRETO. Correo de Google con acceso a /market/admin
ADMIN_COPY_EMAIL=                       # SECRETO. Recibe una COPIA aparte de cada correo de compra/descarga

# ── Correo ─────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=mock                     # cloudflare | resend | mock (mock no se permite en live)
EMAIL_FALLBACK_PROVIDER=none            # resend → si Cloudflare falla de forma permanente o 3 veces
EMAIL_FROM="Tony Ciencia <market@tonyciencia.com>"   # debe ser del dominio verificado
EMAIL_REPLY_TO=business@tonyciencia.com
RESEND_API_KEY=                         # SECRETO, solo si se usa Resend (principal o respaldo)

# ── Descargas ──────────────────────────────────────────────────────────────
DOWNLOAD_URL_TTL_SECONDS=300            # vida de la URL firmada del archivo
EMAIL_LINK_TTL_DAYS=14                  # vida del enlace firmado que va en el correo
# Opcional: URLs prefirmadas S3 directas de R2 (si no, el Worker firma y transmite el archivo).
R2_ACCESS_KEY_ID=                       # SECRETO
R2_SECRET_ACCESS_KEY=                   # SECRETO
R2_ACCOUNT_ID=                          # SECRETO
R2_BUCKET_NAME=                         # var: tonyciencia-market-files

# ── Nombres de los bindings (wrangler.jsonc) ───────────────────────────────
# D1:          MARKET_DB    → tonyciencia-market (prod) | -staging | -preview
# R2 privado:  MARKET_FILES → tonyciencia-market-files (prod) | -files-staging
# Correo:      EMAIL        → send_email (Cloudflare Email Sending)
# Estáticos:   ASSETS       → ./public
