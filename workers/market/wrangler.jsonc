{
	// Market Tony — Worker independiente del blog (ver docs/PLAN.md).
	//
	// Entornos:
	//   (raíz)      → desarrollo local con `pnpm dev`. MODE=mock. D1/R2 emulados por Miniflare.
	//   preview     → vista previa en workers.dev. MODE=mock. Sin R2 ni correo reales.
	//   staging     → vista previa en workers.dev. MODE=live con claves de PRUEBA (Stripe test, OAuth de prueba).
	//   production  → tonyciencia.com/market. MODE=live.
	//
	// Las claves NUNCA van aquí: se guardan con `wrangler secret put NOMBRE --env <entorno>`
	// (o en `.dev.vars` para local, que está en .gitignore). Ver HANDOFF.md.
	//
	// Los "REEMPLAZAR_..." son IDs que se obtienen al crear los recursos (HANDOFF.md, paso 2).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tonyciencia-market-dev",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-24",
	"assets": { "directory": "./public", "binding": "ASSETS" },
	"observability": { "enabled": true },
	"vars": {
		"MODE": "mock",
		"SITE_URL": "http://localhost:8787",
		"PAYMENT_PROVIDER": "stripe",
		"EMAIL_PROVIDER": "mock",
		"EMAIL_FALLBACK_PROVIDER": "none",
		"EMAIL_FROM": "Tony Ciencia <market@tonyciencia.com>",
		"EMAIL_REPLY_TO": "business@tonyciencia.com",
		"STRIPE_TAX_ENABLED": "false",
		"ALLOW_LIVE_PAYMENTS": "false",
		"DOWNLOAD_URL_TTL_SECONDS": "120",
		// Popup "10 % en tu primera compra". Solo aparece si el proveedor de pagos da el código por válido.
		"WELCOME_COUPON": "TONYCIENCIA",
		// "true": el cron crea en Stripe (si falta) el cupón del 10 % "once" + el código, con metadata market=true.
		"WELCOME_COUPON_AUTOCREATE": "true",
		"WELCOME_COUPON_PERCENT": "10",
		// Agenda con pago (Google Calendar). Vacío = botón para pedir horarios por correo.
		"BOOKING_URL": "",
		// Google Tag Manager ("GTM-XXXXXXX"). Vacío = apagado: no se carga nada de Google y la CSP no abre sus dominios.
		// Con valor, market.js fija Consent Mode v2 (denegado salvo cookie_consent=accepted del blog) y carga gtm.js.
		// production: contenedor «tonyciencia.com» (cuenta Tony Ciencia, GA4 G-4X663G1K3X), activado el 2026-11-01 junto con
		// el aviso de cookies del market y la sección «Cookies» de la política de privacidad (src/views/legal.tsx).
		"GTM_ID": ""
	},
	"d1_databases": [
		{
			"binding": "MARKET_DB",
			"database_name": "tonyciencia-market-dev",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "MARKET_FILES", "bucket_name": "tonyciencia-market-files-dev" }],
	"triggers": { "crons": ["*/5 * * * *"] },

	"env": {
		"preview": {
			"name": "tonyciencia-market-preview",
			"workers_dev": true,
			"vars": {
				"MODE": "mock",
				"SITE_URL": "https://tonyciencia-market-preview.REEMPLAZAR_SUBDOMINIO.workers.dev",
				"PAYMENT_PROVIDER": "stripe",
				"EMAIL_PROVIDER": "mock",
				"EMAIL_FALLBACK_PROVIDER": "none",
				"EMAIL_FROM": "Tony Ciencia <market@tonyciencia.com>",
				"EMAIL_REPLY_TO": "business@tonyciencia.com",
				"STRIPE_TAX_ENABLED": "false",
				"ALLOW_LIVE_PAYMENTS": "false",
				"DOWNLOAD_URL_TTL_SECONDS": "120",
				"WELCOME_COUPON": "TONYCIENCIA",
				"WELCOME_COUPON_AUTOCREATE": "true",
				"WELCOME_COUPON_PERCENT": "10",
				"BOOKING_URL": "",
				"GTM_ID": ""
			},
			"d1_databases": [
				{
					"binding": "MARKET_DB",
					"database_name": "tonyciencia-market-preview",
					"database_id": "REEMPLAZAR_ID_D1_PREVIEW",
					"migrations_dir": "migrations"
				}
			],
			// Sin R2: en mock los archivos salen del almacén de desarrollo, nunca de un bucket.
			"triggers": { "crons": ["*/5 * * * *"] }
		},

		"staging": {
			"name": "tonyciencia-market-staging",
			"workers_dev": true,
			"vars": {
				"MODE": "live",
				"SITE_URL": "https://tonyciencia-market-staging.REEMPLAZAR_SUBDOMINIO.workers.dev",
				"PAYMENT_PROVIDER": "stripe",
				"EMAIL_PROVIDER": "cloudflare",
				"EMAIL_FALLBACK_PROVIDER": "none",
				"EMAIL_FROM": "Tony Ciencia <market@tonyciencia.com>",
				"EMAIL_REPLY_TO": "business@tonyciencia.com",
				"STRIPE_TAX_ENABLED": "false",
				// Staging solo acepta claves sk_test_: dejar en "false".
				"ALLOW_LIVE_PAYMENTS": "false",
				"DOWNLOAD_URL_TTL_SECONDS": "120",
				"WELCOME_COUPON": "TONYCIENCIA",
				"WELCOME_COUPON_AUTOCREATE": "true",
				"WELCOME_COUPON_PERCENT": "10",
				"BOOKING_URL": "",
				"GTM_ID": ""
			},
			"d1_databases": [
				{
					"binding": "MARKET_DB",
					"database_name": "tonyciencia-market-staging",
					"database_id": "REEMPLAZAR_ID_D1_STAGING",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [{ "binding": "MARKET_FILES", "bucket_name": "tonyciencia-market-files-staging" }],
			"send_email": [{ "name": "EMAIL" }],
			"triggers": { "crons": ["*/5 * * * *"] }
		},

		"production": {
			"name": "tonyciencia-market",
			"workers_dev": false,
			// Dos rutas a propósito: "tonyciencia.com/market*" capturaría también /marketing-digital.
			"routes": [
				{ "pattern": "tonyciencia.com/market", "zone_name": "tonyciencia.com" },
				{ "pattern": "tonyciencia.com/market/*", "zone_name": "tonyciencia.com" }
			],
			"vars": {
				"MODE": "live",
				"SITE_URL": "https://tonyciencia.com",
				"PAYMENT_PROVIDER": "stripe",
				"EMAIL_PROVIDER": "cloudflare",
				"EMAIL_FALLBACK_PROVIDER": "none",
				"EMAIL_FROM": "Tony Ciencia <market@market.tonyciencia.com>",
				"EMAIL_REPLY_TO": "business@tonyciencia.com",
				"STRIPE_TAX_ENABLED": "false",
				// "true": el dueño aprobó cobrar de verdad con la clave sk_live (2026-10-29).
				"ALLOW_LIVE_PAYMENTS": "true",
				"DOWNLOAD_URL_TTL_SECONDS": "120",
				"WELCOME_COUPON": "TONYCIENCIA",
				"WELCOME_COUPON_AUTOCREATE": "true",
				"WELCOME_COUPON_PERCENT": "10",
				"BOOKING_URL": "",
				"GTM_ID": "GTM-M7CP7J73"
			},
			"d1_databases": [
				{
					"binding": "MARKET_DB",
					"database_name": "tonyciencia-market",
					"database_id": "c42da3d6-35f8-4b19-a702-98b660941cbc",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [{ "binding": "MARKET_FILES", "bucket_name": "tonyciencia-market-files" }],
			"send_email": [{ "name": "EMAIL" }],
			"triggers": { "crons": ["*/5 * * * *"] }
		}
	}
}
