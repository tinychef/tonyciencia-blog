{
  "name": "tonyciencia",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "astro dev",
    "build:seed": "node scripts/build-seed.mjs",
    "check:seo-i18n": "node scripts/check-seo-i18n.mjs",
    "post:new": "node scripts/content/new-post.mjs",
    "post:check": "node scripts/content/validate-post.mjs",
    "aff:find": "node scripts/content/affiliates.mjs",
    "extract:seed": "node scripts/extract-seed-source.mjs",
    "build": "pnpm build:seed && astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "astro check",
